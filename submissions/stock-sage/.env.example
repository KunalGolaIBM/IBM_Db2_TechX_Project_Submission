# IBM Db2 Configuration (Default local Docker credentials)
DB2_HOST=127.0.0.1
DB2_PORT=50000
DB2_DATABASE=testdb
DB2_USER=db2inst1
DB2_PASSWORD=Password123!
DB2_SECURITY=false

# Google Gemini API Key (Optional for offline demo; required for natural language explanations)
GEMINI_API_KEY=your_gemini_api_key_here

# Application Configuration
APP_ENV=development
USE_MOCK_DB=false
