# =============================================================================
# LOTLINE — Environment Configuration (.env.example)
# IBM Db2 TechX Summit / Db2Hack 2026 Submission
# =============================================================================

# --- IBM Db2 12.1 Database Connection ---
DB2_HOST=127.0.0.1
DB2_PORT=50000
DB2_DATABASE=testdb
DB2_SCHEMA=LOTLINE_APP
DB2_USER=db2inst1
DB2_PASSWORD=your_db2_password_here

# --- Google Gemini AI Integration (Optional) ---
# If omitted or invalid, LOTLINE operates in deterministic fallback mode
# using verified IBM Db2 facts with zero hallucinations.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# --- Backend Application Settings ---
APP_HOST=127.0.0.1
APP_PORT=8000
ENVIRONMENT=production

# --- Frontend API Configuration (Vite) ---
VITE_API_BASE_URL=http://127.0.0.1:8000/api
