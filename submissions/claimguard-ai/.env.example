# ==============================================================================
# ClaimGuard AI - Environment Configuration (.env.example)
# IMPORTANT: Provide placeholder dummy values only. NEVER commit real credentials.
# ==============================================================================

# IBM Db2 Enterprise Relational Database
DB2_HOST=localhost
DB2_PORT=50000
DB2_DATABASE=testdb
DB2_USER=db2inst1
DB2_PASSWORD=your_db2_password_here
DB2_SCHEMA=CLAIMGUARD
DB2_SECURITY=false
DB2_USE_SSL=false

# Google Gemini API (Document Intelligence & Verification)
GEMINI_API_KEY=your_google_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# Application Configuration & Security
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Authentication (JWT for Human Reviewers & Admins)
JWT_SECRET=claimguard_super_secret_jwt_key_change_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# System Flags
# If DEMO_MODE=true and Db2 is unreachable, the system will explicitly label demo mode
# in API and UI, maintaining full schema parity and data integrity.
DEMO_MODE=false
UPLOAD_DIR=./uploads
