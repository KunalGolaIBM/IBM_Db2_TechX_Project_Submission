# Db2 connection settings (demo placeholders only)
DB2_HOST=db2
DB2_PORT=50000
DB2_DB=clinic
DB2_USER=db2inst1
DB2_PASSWORD=change-with-strong-pass
DB2_SCHEMA=DB2INST1
