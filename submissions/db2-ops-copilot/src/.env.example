# Db2 Ops Copilot — local environment template
# Copy to .env and fill in locally. NEVER commit the real .env file.
# Passwords are generated locally (e.g. via Python secrets) and entered only here.
# Every variable below is OPTIONAL in mock mode: the app starts with zero
# external services using safe defaults.

# ============================================================================
# Application
# ============================================================================
# development | testing | production
ENVIRONMENT=development
# Verbose error detail + debug routes. Never true in production.
DEBUG=true
# Extra logging detail (DEBUG | INFO | WARNING | ERROR | CRITICAL)
LOG_LEVEL=INFO
# Optional log file path (empty = stdout only)
LOG_FILE=
# Comma-separated allow-list (no wildcard). Vite dev server default:
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# Serve frontend/dist from FastAPI when present (set false behind a CDN/nginx)
SERVE_FRONTEND=true

# ============================================================================
# Adapter selection — the mock/real switch
# ============================================================================
# mock = fully offline, deterministic canned data (development & tests).
# real = genuine Db2 + Ollama + LangChain adapters (requires
#        requirements-integration.txt + running services; see DEPLOYMENT.md).
ADAPTER_MODE=mock

# ============================================================================
# IBM Db2 (only used when ADAPTER_MODE=real)
# ============================================================================
# Generated at instance setup; used for both instance owner and database users.
DB2_INSTANCE_PASSWORD=
# Dev database created in M1.4
DB2_DBNAME=testdb
# Read-only application account created in M1.4 (least privilege; see
# database/migrations/003_readonly_user.sql)
DB2_RO_USER=db2ro
DB2_RO_PASSWORD=
# Connection target (port bound to 127.0.0.1 only — never expose publicly)
DB2_HOST=127.0.0.1
DB2_PORT=50000
# TCP connect timeout for health probes, milliseconds
DB2_CONNECT_TIMEOUT_MS=3000
# Schema owning the application tables (APP_AUDIT, DEMO_*, COPILOT_KB).
# Schema introspection reads SYSCAT for THIS schema — not the login user's.
DB2_APP_SCHEMA=APP
# Schema holding the EXPLAIN_* tables (created by SYSPROC.SYSINSTALLOBJECTS,
# see database/migrations/005_dba_tools.sql). Plain identifier only.
DB2_EXPLAIN_SCHEMA=SYSTOOLS
# Default row limit for DBA tools (1-100)
DBA_DEFAULT_LIMIT=20

# ============================================================================
# Ollama (only used when ADAPTER_MODE=real)
# ============================================================================
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_LLM_MODEL=granite4.2:3b
OLLAMA_EMBED_MODEL=nomic-embed-text:v1.5
# Generation/embedding request timeout, milliseconds
OLLAMA_TIMEOUT_MS=30000
# Embedding vector dimensions (nomic-embed-text:v1.5 = 768)
EMBEDDING_DIMENSIONS=768

# ============================================================================
# SQL security policy (guardrails on generated SQL — see docs/ARCHITECTURE.md)
# ============================================================================
# Max characters of SQL accepted by the validation gate
SQL_MAX_LENGTH=5000
# Max AST nodes / subqueries / joins / IN-list length
SQL_MAX_AST_NODES=500
SQL_MAX_SUBQUERIES=6
SQL_MAX_JOINS=8
SQL_MAX_IN_LIST=200
# Hard row cap applied by the executor + advisory warning when absent
SQL_MAX_ROWS=100
SQL_QUERY_TIMEOUT_MS=10000
SQL_ENFORCE_ROW_LIMIT=true
# Comma-separated schemas the generated-SQL gate must never touch
SQL_DENIED_SCHEMAS=SYSCAT,SYSIBM,SYSSTAT,SYSPROC,SYSIBMADM,SYSIBMSECURITY,SYSTOOLS

# ============================================================================
# Security — prompt-injection defense on the chat surface
# ============================================================================
# off | flag | block (block = secure default: rejected messages get HTTP 400)
INJECTION_MODE=block
# Max characters accepted in a chat message
SECURITY_MAX_MESSAGE_LENGTH=4000
