# ==============================================================================
# IBM Db2 Vector Search Study Assistant - Environment Configuration
# ==============================================================================

# IBM Db2 Database Connection Parameters
DB2_DATABASE=testdb
DB2_HOST=localhost
DB2_PORT=50000
DB2_PROTOCOL=TCPIP
DB2_USER=db2inst1
DB2_PASSWORD=YourDb2Password123!
DB2_SCHEMA=
DB2_TABLE_NAME=STUDENT_NOTES_VS

# Optional: Full connection string (overrides individual parameters above if provided)
# DB2_CONNECTION_STRING=DATABASE=testdb;HOSTNAME=localhost;PORT=50000;PROTOCOL=TCPIP;UID=db2inst1;PWD=YourDb2Password123!;

# Vector Embedding Configuration
EMBEDDING_MODEL=sentence-transformers/all-mpnet-base-v2
EMBEDDING_DIM=768
DISTANCE_STRATEGY=COSINE

# Chunking & Retrieval Parameters
CHUNK_SIZE=800
CHUNK_OVERLAP=150
TOP_K=4
SIMILARITY_THRESHOLD=0.40

# LLM Backend Providers (Select watsonx, gemini, openai, ollama, or local)
LLM_PROVIDER=auto

# IBM watsonx.ai (Recommended for IBM Db2 TechX Summit)
WATSONX_APIKEY=your_watsonx_api_key_here
WATSONX_PROJECT_ID=your_watsonx_project_id_here
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_MODEL_ID=ibm/granite-3-8b-instruct

# Google Gemini API (Alternative)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# OpenAI API (Alternative)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Ollama Local LLM (Zero-Cloud / Offline)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=granite3.3:8b

