# Copy to .env and fill in. .env is gitignored: never commit it.

# --- Db2 ---
# Any database works: the notebook creates its own schema, TEMPORAL_RECIPE, and drops it at the end.
# The user must be allowed to create tables (the instance owner is).
DB_NAME=SAMPLE
DB_HOST=localhost
DB_PORT=50000
DB_PROTOCOL=tcpip
DB_USER=db2inst1
DB_PASSWORD=your-db2-password
