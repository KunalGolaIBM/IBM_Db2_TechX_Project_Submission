# AsOf configuration. Copy to .env and edit:  cp .env.example .env
# .env is gitignored. Never commit real passwords or keys.

# --- IBM Db2 ---------------------------------------------------------------
# The organizers' variable names. The defaults fit all three setup paths in the README:
#   A. IBM Db2 VS Code extension ("Create Db2 instance"): use the password you chose there.
#   B. Plain Docker with IBM's image: this password becomes DB2INST1_PASSWORD.
#   C. AsOf's docker compose (Apple Silicon): `docker compose up -d --wait db2` uses it.
# DB2_CONTAINER is only used by setup to create the two OS users inside the container;
# if it is not running, setup also tries db2server, then any single running Db2 container.
# (DB2_ADMIN_USER / DB2_ADMIN_PASSWORD are still accepted as older names.)
DB2_HOST=localhost
DB2_PORT=50000
DB2_DATABASE=testdb
DB2_USER=db2inst1
DB2_PASSWORD=change-me-db2-admin
DB2_CONTAINER=asof-db2

# Least-privilege users that setup creates inside the Db2 container.
# Leave the passwords empty and setup generates strong ones and writes them here.
ASOF_APP_USER=asofapp
ASOF_APP_PASSWORD=
ASOF_EDITOR_USER=asofedit
ASOF_EDITOR_PASSWORD=

# --- LLM provider ------------------------------------------------------------
# openrouter (default), ollama (local, no key), or openai_compatible.
LLM_PROVIDER=openrouter

# OpenRouter: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_MODEL=google/gemini-3.1-flash-lite

# Ollama: install from https://ollama.com, then `ollama pull qwen2.5:7b-instruct`
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b-instruct

# Any other OpenAI-compatible endpoint (used when LLM_PROVIDER=openai_compatible)
OPENAI_COMPAT_BASE_URL=https://api.openai.com/v1
OPENAI_COMPAT_API_KEY=your-api-key-here
OPENAI_COMPAT_MODEL=gpt-4.1-mini

# Per-call limits. Every LLM call has a hard deadline and an output cap, and the
# gate fails closed (ESCALATED) when either is hit. For local Ollama on a laptop, use 180.
LLM_TIMEOUT_S=60
LLM_MAX_RETRIES=2
LLM_MAX_OUTPUT_TOKENS=1000
