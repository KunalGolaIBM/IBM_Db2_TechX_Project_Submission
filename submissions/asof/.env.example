# AsOf configuration. Copy to .env and edit:  cp .env.example .env
# .env is gitignored. Never commit real passwords or keys.

# --- IBM Db2 ---------------------------------------------------------------
# The organizers' variable names. The defaults fit all three setup paths in the README:
#   A. IBM Db2 VS Code extension ("Create Db2 instance"): use the password you chose there.
#   B. Plain Docker with IBM's image: this password becomes DB2INST1_PASSWORD.
#   C. AsOf's docker compose (Apple Silicon): `docker compose up -d --wait db2` uses it.
# DB2_CONTAINER is only used by setup to create the five OS users inside the container;
# if it is not running, setup also tries db2server, then any single running Db2 container.
# (DB2_ADMIN_USER / DB2_ADMIN_PASSWORD are still accepted as older names.)
# DB2_PASSWORD is empty on purpose: set it before starting Db2 on path B or C, because Db2 keeps the
# password it first started with (docker compose refuses to start while it is empty).
DB2_HOST=localhost
DB2_PORT=50000
DB2_DATABASE=testdb
DB2_USER=db2inst1
DB2_PASSWORD=
DB2_CONTAINER=asof-db2
# TLS to Db2: needed for a remote Db2 such as Db2 on Cloud (README, "TLS to Db2"). Off for the local setups.
# DB2_SSL_SERVER_CERT optionally pins the server's or its CA's certificate file (relative to this folder).
DB2_SSL=false
DB2_SSL_SERVER_CERT=
# Host port for TLS once scripts/enable_db2_tls.sh has turned it on in the local container.
DB2_TLS_PORT=50001
# Seconds to wait for a connection, and for a row lock (runtime users) before failing closed.
DB2_CONNECT_TIMEOUT_S=15
DB2_LOCK_TIMEOUT_S=10

# Least-privilege users that setup creates inside the Db2 container.
# Leave the passwords empty and setup generates strong ones and writes them here.
ASOF_APP_USER=asofapp
ASOF_APP_PASSWORD=
ASOF_EDITOR_USER=asofedit
ASOF_EDITOR_PASSWORD=
# Specialist decisions (inbox replies, correction notices); setup generates the password.
ASOF_REVIEW_USER=asofrev
ASOF_REVIEW_PASSWORD=
# Read-only analyst for "Ask the ledger": audit views only, customer text masked by Db2.
ASOF_ANALYST_USER=asofread
ASOF_ANALYST_PASSWORD=
# dbt's user for the optional marts: reads four tables, builds only in ASOF_MART.
ASOF_MART_USER=asofmart
ASOF_MART_PASSWORD=
# Domain-scoped users: Db2's row permissions show each only its own policy domain's decisions
# (docs/row-permissions.md). An analyst ("Ask the ledger" scope) and a specialist per domain.
ASOF_AIRLINE_ANALYST_USER=airread
ASOF_AIRLINE_ANALYST_PASSWORD=
ASOF_AIRLINE_REVIEW_USER=airrev
ASOF_AIRLINE_REVIEW_PASSWORD=
ASOF_BANK_ANALYST_USER=bankread
ASOF_BANK_ANALYST_PASSWORD=
ASOF_BANK_REVIEW_USER=bankrev
ASOF_BANK_REVIEW_PASSWORD=

# API authentication. "local" (default): the server binds to localhost, and the optional shared tokens below
# apply. "users": every /api/ request needs a personal token with the route's role (checker, auditor,
# editor, reviewer), kept as a SHA-256 in Db2; add users with: python -m asof.users add <name> --roles checker,auditor
ASOF_AUTH=local
# Optional: require "Authorization: Bearer <token>" on every /api/ request (leave empty to rely on
# the localhost-only binding). Policy edits additionally need ASOF_EDITOR_TOKEN from a non-local client.
ASOF_API_TOKEN=
ASOF_EDITOR_TOKEN=
# Chain-head anchors: after each ledger append, the new head is written with an HMAC to a log outside Db2,
# so a ledger rebuilt by the database owner is caught even without receipts. The HMAC key is NOT kept here:
# python -m asof.setup generates it in its own file outside this folder (mode 600), by default
# ~/.config/asof/anchor.key ($XDG_CONFIG_HOME/asof/anchor.key if set). Point elsewhere with
# ASOF_ANCHOR_KEY_FILE (a path inside this folder is refused). ASOF_ANCHOR_KEY overrides the file from the
# environment, for containers and CI only. ASOF_ANCHOR_DIR (default var/anchors) holds the logs.
# ASOF_ANCHOR_KEY_FILE=~/.config/asof/anchor.key
# ASOF_ANCHOR_KEY=
# ASOF_ANCHOR_DIR=var/anchors
# Host headers the API answers to (protects the localhost API from DNS rebinding).
ASOF_ALLOWED_HOSTS=127.0.0.1,localhost,::1
# A hosted public demo: replay mode only, no model keys, no policy changes or sends, limits per address.
ASOF_PUBLIC_DEMO=false
# Live checks on the public demo (docs/public-demo.md): input that is not a recorded built-in scenario is checked by
# OpenRouter; the built-in scenarios keep replaying. Needs ASOF_PUBLIC_DEMO=true and LLM_PROVIDER=replay, and
# OPENROUTER_API_KEY in the process environment (a systemd EnvironmentFile), never in this file. Db2 holds the daily cap
# for the whole demo; the per-visitor limits (per minute, per UTC day) are kept in memory.
ASOF_DEMO_LIVE=false
ASOF_DEMO_LIVE_DAILY_CAP=400
ASOF_DEMO_LIVE_PER_MINUTE=3
ASOF_DEMO_LIVE_PER_DAY=20

# --- LLM provider ------------------------------------------------------------
# openrouter (default), ollama (local, no key), openai_compatible, watsonx (IBM watsonx.ai, below), or
# replay: no model at all, the
# built-in scenarios answered from recorded model outputs (Db2, rule checks and ledger still run live;
# any other input is held for a specialist). ./quickstart.sh picks replay when no key is set.
LLM_PROVIDER=openrouter

# OpenRouter: https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-3.1-flash-lite
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Ollama: install from https://ollama.com, then `ollama pull qwen2.5:7b-instruct`
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b-instruct

# Any other OpenAI-compatible endpoint (used when LLM_PROVIDER=openai_compatible)
OPENAI_COMPAT_BASE_URL=https://api.openai.com/v1
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=gpt-4.1-mini

# Local embeddings (CPU) for claims, and for clauses when Db2 does not embed them itself.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- In-database embeddings (Db2 12.1.5 CREATE EXTERNAL MODEL + TO_EMBEDDING) ---------
# auto: on when an API key is available (EMBEDDING_API_KEY, else OPENROUTER_API_KEY).
# The endpoint must serve the same model the app uses (all-MiniLM-L6-v2); setup checks it.
# IBM documents HTTPS endpoints; plain HTTP is accepted only for a local endpoint (dev use).
ASOF_INDB_EMBEDDINGS=auto
EMBEDDING_API_URL=https://openrouter.ai/api/v1/embeddings
EMBEDDING_API_MODEL=sentence-transformers/all-minilm-l6-v2
EMBEDDING_API_KEY=

# Per-call limits. Every LLM call has a hard deadline and an output cap, and the
# gate fails closed (ESCALATED) when either is hit. For local Ollama on a laptop, use 180.
LLM_TIMEOUT_S=60
LLM_MAX_RETRIES=2
LLM_MAX_OUTPUT_TOKENS=1000
# Sampling temperature: unset by default, because several current models reject the parameter.
# LLM_TEMPERATURE=0
# Whole-check budget in seconds: no step of a check starts after it, and the check fails closed.
ASOF_CHECK_DEADLINE_S=300
# Routing (doc_id "auto"): Db2's vector vote routes clear cases; close calls go to the routing agent or a person.
# auto: the agent runs only with a model measured not to misroute or guess on the pinned split (docs/routing_eval.md);
# on: with any model; off: close calls always go to a person.
ASOF_ROUTER_AGENT=auto

# Backtests (docs/backtest.md): the most rows one uploaded CSV may hold (Db2 refuses more than 500 anyway), and a
# run's deadline in seconds: no row starts after it, and the rows left are recorded as skipped.
ASOF_BACKTEST_MAX_ROWS=500
ASOF_BACKTEST_DEADLINE_S=1800

# If the hosted model fails or times out, the same call goes once to local Ollama (if it
# runs), and the ledger records it. none = no fallback.
LLM_FALLBACK=ollama
LLM_FALLBACK_TIMEOUT_S=180

# IBM watsonx.ai (optional). LLM_PROVIDER=watsonx uses it for the check (pip install -r requirements-watsonx.txt);
# ASOF_INDB_PROVIDER=watsonx makes Db2 itself call watsonx.ai for clause embeddings (CREATE EXTERNAL MODEL
# ... PROVIDER WATSONX; no extra package). Needs an IBM Cloud API key and the project ID of a watsonx.ai
# project with the watsonx.ai Runtime service associated. WATSONX_URL is your region's endpoint:
# us-south, eu-de, eu-gb, jp-tok, au-syd or ca-tor (https://<region>.ml.cloud.ibm.com).
WATSONX_API_KEY=
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_PROJECT_ID=
# WATSONX_SPACE_ID=   (a deployment space instead of a project)
WATSONX_MODEL=ibm/granite-4-h-small
WATSONX_EMBEDDING_MODEL=sentence-transformers/all-minilm-l6-v2
ASOF_INDB_PROVIDER=openai

# Policy intake (upload a policy PDF): its one model call copies whole clauses, so it gets a
# larger output cap and a longer deadline than the calls of a check.
ASOF_INTAKE_MAX_OUTPUT_TOKENS=4000
ASOF_INTAKE_TIMEOUT_S=150
