  {
   "clause_id": "ATM-001",
   "doc_id": "FERNHOLLOW-FEES",
   "area": "atm",
   "title": "Out-of-network ATM fee",
   "versions": [
    {
     "version_label": "v1",
     "bus_start": "2026-01-01",
     "bus_end": "2026-10-01",
     "clause_text": "We charge $3 for each withdrawal at an ATM outside the Fernhollow network. The ATM's owner may charge its own fee as well.",
     "rule": {
      "out_of_network_atm_fee_usd": 3
     }
    },
    {
     "version_label": "v2",
     "bus_start": "2026-10-01",
     "bus_end": "9999-12-31",
     "clause_text": "We charge $4 for each withdrawal at an ATM outside the Fernhollow network. The ATM's owner may charge its own fee as well.",
     "rule": {
      "out_of_network_atm_fee_usd": 4
     }
    }
   ]
  },
  {
   "clause_id": "ATM-002",
   "doc_id": "FERNHOLLOW-FEES",
   "area": "atm",
   "title": "Daily ATM withdrawal limit",
   "versions": [
    {
     "version_label": "v1",
     "bus_start": "2026-01-01",
     "bus_end": "9999-12-31",
     "clause_text": "You can withdraw up to $800 per day from ATMs with your debit card.",
     "rule": {
      "max_daily_withdrawal_usd": 800
     }
    }
   ]
  },
  {
   "clause_id": "DSP-001",
   "doc_id": "FERNHOLLOW-FEES",
   "area": "dispute",
