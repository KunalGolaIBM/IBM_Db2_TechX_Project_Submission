 "clauses": [
  {
   "clause_id": "OVD-001",
   "doc_id": "FERNHOLLOW-FEES",
   "area": "overdraft",
   "title": "Overdraft fee",
   "versions": [
    {
     "version_label": "v1",
     "bus_start": "2026-01-01",
     "bus_end": "2026-07-01",
     "clause_text": "An overdraft fee of $35 is charged for each item we pay when the account does not have enough available funds.",
     "rule": {
      "overdraft_fee_usd": 35
     }
    },
    {
     "version_label": "v2",
     "bus_start": "2026-07-01",
     "bus_end": "9999-12-31",
     "clause_text": "An overdraft fee of $25 is charged for each item we pay when the account does not have enough available funds.",
     "rule": {
      "overdraft_fee_usd": 25
     }
    }
   ]
  },
  {
   "clause_id": "OVD-002",
   "doc_id": "FERNHOLLOW-FEES",
   "area": "overdraft",
   "title": "Overdraft fee limits",
   "versions": [
    {
     "version_label": "v1",
     "bus_start": "2026-01-01",
     "bus_end": "9999-12-31",
     "clause_text": "We charge no more than 3 overdraft fees per business day. No overdraft fee is charged if the account is overdrawn by $5 or less at the end of the business day.",
     "rule": {
      "max_overdraft_fees_per_day": 3,
      "max_no_fee_overdraft_usd": 5
     }
    }
   ]
  },
  {
   "clause_id": "OVD-003",
   "doc_id": "FERNHOLLOW-FEES",
   "area": "overdraft",
   "title": "Overdraft protection transfers",
   "versions": [
    {
     "version_label": "v1",
     "bus_start": "2026-01-01",
     "bus_end": "2026-10-01",
     "clause_text": "Each overdraft protection transfer from a linked Fernhollow savings account costs $10.",
     "rule": {
      "overdraft_transfer_fee_usd": 10
     }
    },
    {
     "version_label": "v2",
     "bus_start": "2026-10-01",
     "bus_end": "9999-12-31",
     "clause_text": "Overdraft protection transfers from a linked Fernhollow savings account are free.",
     "rule": {
      "overdraft_transfer_fee_usd": 0
     }
    }
   ]
  },
  {
   "clause_id": "FRV-001",
   "doc_id": "FERNHOLLOW-FEES",
   "area": "fee_refund",
   "title": "Courtesy refund of overdraft fees",
   "versions": [
    {
     "version_label": "v1",
     "bus_start": "2026-01-01",
     "bus_end": "2026-08-01",
     "clause_text": "Overdraft fees are not refunded automatically. A customer may ask for a courtesy refund of one overdraft fee in any 12-month period. The request must be made within 30 days of the date the fee was charged.",
     "rule": {
      "automatic_refund": false,
      "courtesy_refunds_per_year": 1,
      "request_window_days": 30,
      "courtesy_period_months": 12
     }
    },
    {
     "version_label": "v2",
     "bus_start": "2026-08-01",
     "bus_end": "9999-12-31",
     "clause_text": "Overdraft fees are not refunded automatically. A customer may ask for a courtesy refund of up to two overdraft fees in any 12-month period. The request must be made within 60 days of the date the fee was charged.",
     "rule": {
      "automatic_refund": false,
      "courtesy_refunds_per_year": 2,
      "request_window_days": 60,
      "courtesy_period_months": 12
     }
    }
   ]
  },
  {
   "clause_id": "FRV-002",
   "doc_id": "FERNHOLLOW-FEES",
   "area": "fee_refund",
   "title": "Refund of fees charged in error",
   "versions": [
    {
     "version_label": "v1",
     "bus_start": "2026-01-01",
     "bus_end": "9999-12-31",
     "clause_text": "A fee charged in error is refunded in full to the account within 5 business days of our confirming the error.",
     "rule": {
      "error_refund_business_days": 5
     }
    }
   ]
  },
  {
   "clause_id": "MTF-001",
   "doc_id": "FERNHOLLOW-FEES",
   "area": "monthly_fee",
   "title": "Monthly maintenance fee",
   "versions": [
    {
     "version_label": "v1",
     "bus_start": "2026-01-01",
     "bus_end": "2026-09-01",
     "clause_text": "The Everyday Checking account has a monthly maintenance fee of $12.",
     "rule": {
      "monthly_fee_usd": 12
     }
    },
    {
     "version_label": "v2",
     "bus_start": "2026-09-01",
     "bus_end": "9999-12-31",
     "clause_text": "The Everyday Checking account has a monthly maintenance fee of $15.",
     "rule": {
      "monthly_fee_usd": 15
     }
    }
   ]
  },
  {
   "clause_id": "MTF-002",
   "doc_id": "FERNHOLLOW-FEES",
   "area": "monthly_fee",
   "title": "Monthly fee waiver",
   "versions": [
    {
     "version_label": "v1",
     "bus_start": "2026-01-01",
     "bus_end": "2026-09-01",
     "clause_text": "The monthly maintenance fee is waived for any statement period in which the account keeps a minimum daily balance of at least $1,500.",
     "rule": {
      "min_daily_balance_usd": 1500
     }
    },
    {
     "version_label": "v2",
     "bus_start": "2026-09-01",
     "bus_end": "9999-12-31",
     "clause_text": "The monthly maintenance fee is waived for any statement period in which the account keeps a minimum daily balance of at least $1,000.",
     "rule": {
      "min_daily_balance_usd": 1000
     }
    }
   ]
  },
  {
   "clause_id": "MTF-003",
   "doc_id": "FERNHOLLOW-FEES",
   "area": "monthly_fee",
   "title": "Paper statements",
   "versions": [
    {
     "version_label": "v1",
     "bus_start": "2026-01-01",
     "bus_end": "9999-12-31",
     "clause_text": "Paper statements cost $2 per statement. Electronic statements are free.",
     "rule": {
      "paper_statement_fee_usd": 2,
      "electronic_statement_fee_usd": 0
     }
    }
   ]
  },
  {
   "clause_id": "FXF-001",
   "doc_id": "FERNHOLLOW-FEES",
   "area": "foreign_transaction",
