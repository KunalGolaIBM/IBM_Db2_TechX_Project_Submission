   "versions": [
    {
     "version_label": "v1",
     "bus_start": "2026-01-01",
     "bus_end": "9999-12-31",
     "clause_text": "Report an unauthorized debit card transaction within 60 days of the date of the statement on which it first appeared.",
     "rule": {
      "report_window_days": 60
     }
    }
   ]
  },
  {
   "clause_id": "DSP-002",
   "doc_id": "FERNHOLLOW-FEES",
   "area": "dispute",
   "title": "Provisional credit during an investigation",
   "versions": [
    {
     "version_label": "v1",
     "bus_start": "2026-01-01",
     "bus_end": "9999-12-31",
     "clause_text": "If our investigation of a reported error takes longer than 10 business days, we give a provisional credit for the disputed amount within 10 business days of the report while we finish it.",
     "rule": {
      "provisional_credit_business_days": 10
     }
    }
   ]
  },
  {
   "clause_id": "CLS-001",
