# ==============================================================================
# Db2 Sentinel AI - Environment Configuration Template
# ==============================================================================

# Database Engine Mode: 'live' (real IBM Db2 instance) or 'auto' (connects to Db2, falls back to local engine)
DB2_MODE=auto

# IBM Db2 Connection Parameters (Required if DB2_MODE=live)
DB2_DATABASE=testdb
DB2_HOSTNAME=localhost
DB2_PORT=50000
DB2_PROTOCOL=TCPIP
DB2_UID=db2inst1
DB2_PWD=YourSecurePassword123!
DB2_SCHEMA=SENTINEL

# AI & LLM Provider Settings (Optional: built-in deterministic heuristic fallback is active if keys are omitted)
# Supported: 'ollama', 'watsonx', 'openai', 'gemini', 'mock'
LLM_PROVIDER=mock
OPENAI_API_KEY=
WATSONX_APIKEY=
WATSONX_PROJECT_ID=
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=granite3.3:8b

# Embedding Configuration
EMBEDDING_MODEL=ibm-granite/granite-embedding-311m-multilingual-r2
EMBEDDING_DIM=384

# Sentinel Agent Risk Thresholds
AML_ALERT_THRESHOLD=65
HIGH_RISK_THRESHOLD=85
STRUCTURING_WINDOW_HOURS=24
RAPID_VELOCITY_TX_COUNT=3
