# CarbonNova submission - environment template (dummy values only). Never commit real secrets.

# Application
APP_ENV=development
PORT=4000
CORS_ORIGIN=true
VITE_API_URL=http://localhost:4000/api

# IBM Db2 (required for genuine Db2-backed workflows and /api/health/db2)
DB2_HOST=localhost
DB2_PORT=50000
DB2_DATABASE=TESTDB
DB2_USERNAME=db2inst1
# Alternative name supported by code: DB2_USER
DB2_USER=db2inst1
DB2_PASSWORD=replace_with_local_password
# Optional, environment-dependent (e.g. SSL). Set only if your Db2 environment requires it.
DB2_SECURITY=

# AI / LangChain (OpenAI-compatible provider; used by existing AI routes and LangChain workflows)
NEBIUS_API_KEY=replace_with_provider_api_key
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
NEBIUS_MODEL=nvidia/Nemotron-3_5-Lightning
# Generic aliases also supported by LangChain service
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=

# Optional: NVIDIA Build alternate route (existing integration)
NVIDIA_API_KEY=

# Demo/local behavior
CARBONNOVA_NO_SEED=0
CARBONNOVA_MEM=0
