# IBM Db2 Configuration
DB2_HOST=localhost
DB2_PORT=50000
DB2_DATABASE=COLDCHN
DB2_USER=db2inst1
DB2_PASSWORD=your_db2_password_here
DB2_SECURITY=false

# --- CrewAI / LLM configuration (optional) ---
# The workflow runs fully without any key: CrewAI falls back to a deterministic
# explanation built only from stored Db2 facts. Set ONE provider key to enable
# live collaborative AI analysis. Never commit real keys.

# Google Gemini (recommended). GEMINI_MODEL must be a currently supported model.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini/gemini-2.0-flash
# GOOGLE_API_KEY is accepted as an alias of GEMINI_API_KEY.
# GOOGLE_API_KEY=

# OpenAI (alternative provider)
# OPENAI_API_KEY=your_openai_api_key_here

# Generic CrewAI override: set CREWAI_MODEL to a native provider model id
# (e.g. openai/gpt-4o-mini or gemini/gemini-2.0-flash)
# CREWAI_API_KEY=your_provider_key_here
# CREWAI_MODEL=gemini/gemini-2.0-flash

# Application
ENVIRONMENT=development
