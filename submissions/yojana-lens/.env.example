# =====================================================================
# YojanaLens :: environment template
# Copy to .env and fill in. NEVER commit the real .env file.
# =====================================================================

# ---- IBM Db2 (Community Edition in Docker) --------------------------
DB_HOST=db2
DB_PORT=50000
DB_NAME=YOJANADB
DB_USER=db2inst1
DB_PASSWORD=change-me-locally

# ---- Db2 container bootstrap (read by docker-compose) ---------------
# Must be accepted for the Db2 Community Edition image to start.
DB2_LICENSE=accept
DB2_INSTANCE_PASSWORD=change-me-locally

# ---- Embeddings ------------------------------------------------------
# Runs fully offline. 384 dimensions -> matches VECTOR(384, FLOAT32).
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384

# ---- LLM -------------------------------------------------------------
# Any OpenAI-compatible endpoint works: Groq, OpenRouter, OpenAI, Gemini's
# compat endpoint, or a local Ollama (http://host.docker.internal:11434/v1).
# Leave LLM_API_KEY empty to run in deterministic MOCK mode: every feature
# still works, narration is templated instead of model-generated.
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile
LLM_API_KEY=
LLM_TEMPERATURE=0.1
LLM_TIMEOUT_SECONDS=45

# Alternative: IBM watsonx.ai (Granite)
# LLM_BASE_URL=https://us-south.ml.cloud.ibm.com/ml/v1
# LLM_MODEL=ibm/granite-3-8b-instruct

# ---- Retrieval -------------------------------------------------------
RETRIEVER_TOP_K=8
