# Browser configuration. This value is public because Vite embeds VITE_* values.
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Used by `npm run demo:api`.
API_BASE_URL=http://localhost:8000/api/v1

# IBM Db2. The backend reads one ibm_db connection string from DB2_DSN.
# Component form (recommended for IBM Cloud Db2):
DB2_DSN="DATABASE=BLUDB;HOSTNAME=db2.example.com;PORT=50001;PROTOCOL=TCPIP;SECURITY=SSL;"
DB2_USER=replace-with-db2-user
DB2_PASSWORD=replace-with-db2-password
# Hosted Free/Lite: replace CHESS with the schema assigned to your Db2 user.
DB2_SCHEMA=CHESS

# Alternative for a locally cataloged Db2 database alias:
# DB2_DSN="MY_CATALOGED_DB"

# Comma-separated browser origins allowed by FastAPI CORS.
API_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional live-Db2 integration tests. Leave DB2_TEST_DSN empty to skip them.
DB2_TEST_DSN=""
DB2_TEST_USER=""
DB2_TEST_PASSWORD=""
# The two read-only live checks may use the application schema on Free/Lite.
DB2_TEST_SCHEMA=CHESS_TEST

# Optional LangChain coaching. Ordinary gameplay, persistence, and analytics do
# not require an LLM. Supported providers: disabled, ollama, openai.
COACH_PROVIDER=disabled
COACH_MODEL=llama3.2
OLLAMA_BASE_URL=http://localhost:11434
OPENAI_API_KEY=""
