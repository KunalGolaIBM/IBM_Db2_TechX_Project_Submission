# Reference only: configure the repository root .env, which is loaded automatically.
# Db2 credentials stay on the backend. Never prefix them with VITE_.
DB2_DSN="DATABASE=BLUDB;HOSTNAME=your-host;PORT=50001;PROTOCOL=TCPIP;SECURITY=SSL;"
DB2_USER=your-db2-user
DB2_PASSWORD=your-db2-password
# On hosted Free/Lite, use your assigned schema instead of CHESS.
DB2_SCHEMA=CHESS

# Comma-separated browser origins. The default is the existing Vite server.
API_CORS_ORIGINS=http://localhost:5173

# Optional: disabled (default), ollama, or openai.
COACH_PROVIDER=disabled
COACH_MODEL=llama3.2
OLLAMA_BASE_URL=http://localhost:11434
# OPENAI_API_KEY=only-needed-when-COACH_PROVIDER-is-openai

