{
  "name": "cinematic-chess",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test:unit": "node --experimental-strip-types --test tests/*.test.ts",
    "test:browser": "node test-games.mjs",
    "test:backend": "backend/.venv/bin/python -m pytest -c backend/pytest.ini backend/tests",
    "backend:dev": "backend/.venv/bin/python -m uvicorn backend.app.main:app --reload --port 8000",
    "db:init": "backend/.venv/bin/python -m backend.scripts.init_db",
    "db:rebuild-openings": "backend/.venv/bin/python -m backend.scripts.rebuild_opening_stats",
    "demo:api": "backend/.venv/bin/python -m backend.scripts.demo_api"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.4.0",
    "@react-three/postprocessing": "^3.0.4",
    "chess.js": "^1.4.0",
    "gsap": "^3.13.0",
    "postprocessing": "^6.38.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "stockfish": "^18.0.8",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^5.0.4",
    "playwright": "^1.61.1",
    "typescript": "^5.9.2",
    "vite": "^7.1.7"
  }
}
