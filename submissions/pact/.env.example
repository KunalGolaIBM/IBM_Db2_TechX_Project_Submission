# ==============================================================================
# PACT (Procurement Audit & Counterfactual Triage) - Environment Configuration
# TEMPLATE ONLY: Copy to .env locally and fill in your values.
# NEVER COMMIT REAL PASSWORDS OR API KEYS TO SOURCE CONTROL.
# ==============================================================================

# IBM Db2 Database Configuration
DB2_HOST=127.0.0.1
DB2_PORT=50000
DB2_DATABASE=PACTDB
DB2_USER=db2inst1
DB2_PASSWORD=your_db2_password_here

# AI / LLM Provider Configuration (Optional for deterministic core; required for LangChain agent)
# Supported LLM_PROVIDER options: openai
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=your_openai_api_key_here

# Application Server Configuration
APP_HOST=0.0.0.0
APP_PORT=8000
APP_ENV=development
