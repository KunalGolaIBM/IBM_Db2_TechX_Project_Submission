# IBM Db2 connection (placeholders only - copy to .env and fill in; never commit .env)
DB2_HOST=localhost
DB2_PORT=50000
DB2_DATABASE=REDB
DB2_USER=db2inst1
DB2_PASSWORD=your_db2_password_here
# Set to SSL for Db2 on Cloud / TLS endpoints; leave empty for local Docker
DB2_SECURITY=
TARGET_SCHEMA=RETAIL

# Google Gemini (optional - without a key reDB runs in deterministic offline mode)
GOOGLE_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash
GEMINI_EMBED_MODEL=models/gemini-embedding-001
EMBED_DIM=768
