# PortProof configuration -- PLACEHOLDERS ONLY.
# Copy to .env and fill in. .env is git-ignored and must never be committed.

# ---------------------------------------------------------------------------
# IBM Db2 (Community Edition is free; no API key or account is needed)
# ---------------------------------------------------------------------------
DB2_HOST=localhost
DB2_PORT=50000
DB2_DATABASE=testdb
DB2_SCHEMA=PORTPROOF

# The RUNTIME identity. Least privilege: it can SELECT the ledger and CALL the
# three stored procedures, and nothing else. It cannot INSERT into any table
# directly and cannot create objects.
DB2_USER=ppapp
DB2_PASSWORD=replace_with_your_runtime_password

# The SCHEMA OWNER. Used only by `python -m src.setup_db` and to create the
# throwaway adversarial fixtures. Create both users with:
#   bash scripts/create_db2_users.sh
# If you leave these blank, PortProof falls back to DB2_USER for everything,
# which is simpler but gives up the privilege separation.
DB2_SETUP_USER=ppown
DB2_SETUP_PASSWORD=replace_with_your_owner_password

# ---------------------------------------------------------------------------
# Repair model
# ---------------------------------------------------------------------------
# mock = deterministic rewrite rules. THE DEFAULT, and it needs no API key:
#        the full demo, the proofs and the tests all run offline.
# http = any OpenAI-compatible chat endpoint (Groq, Gemini compatibility layer,
#        watsonx, a local server).
LLM_PROVIDER=mock

# Only read when LLM_PROVIDER=http
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile

# How many times Db2 may reject a repair before the statement is escalated.
MAX_REPAIR_ATTEMPTS=3

# ---------------------------------------------------------------------------
# Embeddings (local, CPU, free -- downloaded once from Hugging Face)
# ---------------------------------------------------------------------------
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
