# PortProof configuration. PLACEHOLDERS ONLY.
# Copy to .env and fill in. .env is git-ignored and must never be committed.

# ---------------------------------------------------------------------------
# IBM Db2 (Community Edition is free; no API key or account is needed)
# ---------------------------------------------------------------------------
DB2_HOST=localhost
DB2_PORT=50000
DB2_DATABASE=testdb
# Fixed. The ledger schema is spelled out in sql/01_schema.sql, in the SQL PL
# procedure names and in sql/03_grants.sql, so changing it here would move
# nothing; PortProof warns instead of pretending. Left in because it is the
# first thing people look for.
DB2_SCHEMA=PORTPROOF

# The RUNTIME identity. Least privilege: it can SELECT the ledger and CALL the
# three stored procedures, and nothing else. It cannot INSERT into any table
# directly and cannot create objects.
DB2_USER=ppapp
DB2_PASSWORD=replace_with_your_runtime_password

# The SCHEMA OWNER. Used only by `python -m src.setup_db` and to create the
# throwaway adversarial fixtures. Create both users with:
#   bash scripts/create_db2_users.sh
# If you leave these blank, PortProof falls back to DB2_USER for everything,
# which is simpler but gives up the privilege separation.
DB2_SETUP_USER=ppown
DB2_SETUP_PASSWORD=replace_with_your_owner_password

# ---------------------------------------------------------------------------
# The SOURCE engines: the ground truth the differential proof compares against
# ---------------------------------------------------------------------------
# PortProof's semantic verdict is only as good as the engine it compares Db2
# with, so it prefers a real server and declines rather than guessing.
#
# PostgreSQL is OPTIONAL. Without it, an embedded DuckDB stands in, which needs
# no server, but DuckDB's `/` is floating point (7/2 = 3.5 where PostgreSQL
# and Db2 both say 3) and its array_agg text form is its own. The stand-in
# declares those constructs and returns INCONCLUSIVE on them instead of
# reporting a difference that is really DuckDB's. With a real PostgreSQL here,
# they get a verdict:
#
#   docker run -d --name pppg -p 5433:5432 \
#     -e POSTGRES_PASSWORD="$(openssl rand -base64 18)" \
#     -e POSTGRES_DB=pptest postgres:17
#
PG_HOST=localhost
PG_PORT=5433
PG_DATABASE=pptest
PG_USER=postgres
PG_PASSWORD=replace_with_your_postgres_password

# MySQL has NO fallback, on purpose. Its default collation is case-insensitive
# and `7 / 2` is 3.5; those are properties of the *engine*, not of the data, so
# no fixture can make a PostgreSQL-compatible engine behave like MySQL.
# PortProof used to stand in DuckDB for MySQL anyway, and consequently
# certified a statement EQUIVALENT that MySQL and Db2 genuinely disagree about.
#
# So: with a MySQL reachable here, the MySQL statements are really proved.
# Without one they are reported INCONCLUSIVE. They are never judged by a
# substitute. Start one with:
#
#   docker run -d --name ppmysql -p 3307:3306 \
#     -e MYSQL_ROOT_PASSWORD="$(openssl rand -base64 18)" \
#     -e MYSQL_DATABASE=pptest mysql:8.4
#
MYSQL_HOST=localhost
MYSQL_PORT=3307
MYSQL_DATABASE=pptest
MYSQL_USER=root
MYSQL_PASSWORD=replace_with_your_mysql_password

# --- SQL Server, optional -------------------------------------------------
# A real SQL Server, used as the source engine for the tsql statements. Like
# MySQL it has no stand-in: leave MSSQL_PASSWORD blank and those statements are
# reported INCONCLUSIVE instead of being judged by another engine.
#   docker run -d --name ppmssql -e ACCEPT_EULA=Y -e MSSQL_PID=Developer \
#     -e MSSQL_SA_PASSWORD=<your password> -p 1434:1433 \
#     mcr.microsoft.com/mssql/server:2022-latest
MSSQL_HOST=localhost
MSSQL_PORT=1434
MSSQL_DATABASE=pptest
MSSQL_USER=sa
MSSQL_PASSWORD=

# SQLite needs nothing: it is the real engine, in process, and always on.

# These same two passwords are what scripts/create_federation.sh uses to reach
# the source engines once, so it can mint a read only account on each and hand
# Db2 that one instead. Nothing else needs them, and the federation script adds
# no variables of its own: the read only password is generated at run time and
# never written to a file. Federation is optional. Without it, a divergence is
# still reported, just without Db2's own opinion on whether the two engines
# held the same rows. See `python -m src.main --federation`.

# ---------------------------------------------------------------------------
# Repair model
# ---------------------------------------------------------------------------
# Which engine PROPOSES repairs. It never approves them: whatever answers here,
# the candidate is checked by src/safety.py and then compiled by Db2 itself, so
# this setting cannot change a verdict, only the quality of the suggestions.
#
# mock   = deterministic rewrite rules. THE DEFAULT, so the whole project, the
#          proofs and the tests run offline with no key and reproduce exactly.
# gemini = a real LLM through Google's OpenAI-compatible surface. Needs only a
#          key; the URL and model below are filled in for you. Get a free key at
#          https://aistudio.google.com/apikey
# http   = any other OpenAI-compatible endpoint (Groq, watsonx, a local server),
#          with LLM_BASE_URL set explicitly.
# tiered = the cost-aware default: Db2's fix memory answers first, the rules
#          second, and a language model is called only for what neither could
#          repair. With no key it is simply memory plus rules, so it needs
#          nothing to run. Uses the gemini endpoint defaults below.
LLM_PROVIDER=tiered

# Read when LLM_PROVIDER is gemini or http. For gemini you may instead put
# GEMINI_API_KEY in .env.local, which is git-ignored and read only for this.
# Leave LLM_BASE_URL and LLM_MODEL blank to accept the provider's defaults
# (gemini: gemini-flash-latest; http: Groq llama-3.3-70b-versatile).
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# How many times Db2 may reject a repair before the statement is escalated.
MAX_REPAIR_ATTEMPTS=3

# Spending controls for the model tiers. All three are enforced in one place.
# The most model calls one run may make; after that the model tiers stop
# answering and the statement is left to the rules and to human review.
LLM_CALL_BUDGET=200
# A ceiling on one answer, reasoning tokens included.
LLM_MAX_OUTPUT_TOKENS=3000
# Sent as reasoning_effort where the provider supports it. Blank to omit.
LLM_REASONING_EFFORT=low

# ---------------------------------------------------------------------------
# Embeddings (local, CPU, free, downloaded once from Hugging Face)
# ---------------------------------------------------------------------------
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
