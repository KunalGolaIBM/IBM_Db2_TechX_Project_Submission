# ---------------------------------------------------------------------------
# AEGIS environment template. Copy to .env and fill in real values.
# NEVER commit .env or real credentials.
# ---------------------------------------------------------------------------

# --- API ---
AEGIS_ENV=development
AEGIS_API_HOST=0.0.0.0
AEGIS_API_PORT=8000
AEGIS_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
AEGIS_MAX_UPLOAD_BYTES=10485760
AEGIS_MAX_SUBMITTED_CHARS=30000
AEGIS_REQUEST_TIMEOUT_SECONDS=600

# --- IBM Db2 (mandatory primary database) ---
DB2_HOST=localhost
DB2_PORT=50000
DB2_DATABASE=TESTDB
DB2_USERNAME=db2inst1
DB2_PASSWORD=change-me
DB2_SCHEMA=AEGIS

# --- LLM provider (LangChain / OpenAI-compatible) ---
# provider label stored with each verification session
LLM_PROVIDER=openai
# model name understood by the provider
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
# Optional OpenAI-compatible endpoint (e.g. a hosted gateway or local server).
# Leave blank for the official OpenAI API.
LLM_BASE_URL=
LLM_TEMPERATURE=0
LLM_TIMEOUT_SECONDS=90
LLM_MAX_RETRIES=2
LLM_MAX_CLAIMS=25
LLM_EVIDENCE_TOP_K=6
LLM_MAX_TOKENS=1500

# Local Ollama alternative (install from https://ollama.com):
# LLM_PROVIDER=ollama
# LLM_MODEL=qwen2.5:7b-instruct
# LLM_API_KEY=ollama
# LLM_BASE_URL=http://localhost:11434/v1
#
# Local 7B inference can take several minutes for four claims. The default
# request timeout is 600 seconds; raise AEGIS_REQUEST_TIMEOUT_SECONDS for slower
# hardware or larger documents.

# --- Frontend ---
# Next.js reads its own env files from frontend/.  Copy
# frontend/.env.example to frontend/.env.local to override the API URL.
# (This root file is read by the FastAPI backend only.)

# --- Retrieval ---
# Lexical retrieval is the default. A future Db2 vector backend can be
# selected here without changing the API contract.
AEGIS_RETRIEVAL_BACKEND=lexical
