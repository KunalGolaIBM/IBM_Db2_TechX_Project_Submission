# ==============================================================================
# Db2Sentinel AI Environment Configuration Example
# Copy this file to .env for local deployment. Never commit real secrets to Git.
# ==============================================================================

# IBM Db2 Database Configuration
DB2_HOST=localhost
DB2_PORT=50000
DB2_DATABASE=SENTINELDB
DB2_USERNAME=sentinel_user
DB2_PASSWORD=CHANGE_ME_SECURE_PASSWORD
DB2_SECURITY=NONE
# Set to 'SSL' if connecting to an SSL-enabled Db2 server (e.g. Db2 on Cloud)
# DB2_SSL_CERTIFICATE=/path/to/db2_cert.arm

# Fallback & Demonstration Mode
# Set to 'true' to allow safe in-memory / local verification when Db2 server is offline
DB2_DEMO_FALLBACK=true

# AI / LLM Configuration (LangChain & LangGraph)
# Supported providers: gemini, openai, ollama, mock
LLM_PROVIDER=mock
LLM_MODEL=gemini-1.5-flash
# LLM_API_KEY=your_api_key_here
# OLLAMA_BASE_URL=http://localhost:11434

# Backend Service Configuration
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Security & Audit Configuration
AUDIT_LOG_ENABLED=true
HUMAN_APPROVAL_TIMEOUT_SECONDS=3600
JWT_SECRET_KEY=CHANGE_ME_SUPER_SECRET_KEY_FOR_JWT
