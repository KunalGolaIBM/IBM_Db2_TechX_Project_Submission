# Copy this file to .env before starting AnnaSetu. Keep .env out of source control.
DB2_HOST=127.0.0.1
DB2_PORT=50000
DB2_NAME=ANNASETU
DB2_USER=db2inst1
DB2_PASSWORD=replace-with-a-strong-local-password

# Use a unique random value of at least 32 characters.
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRE_MINUTES=720
ENVIRONMENT=development
SEED_DEMO_DATA=true
# Private local demo password; also used when seeding a fresh database.
DEMO_PASSWORD=replace-with-a-private-local-demo-password
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5175,http://127.0.0.1:5175

# Admin-approved local recovery is available only when ENVIRONMENT=development.
# No email, SMS, SMTP, or external verification service is used by this MVP.
APP_PUBLIC_URL=http://127.0.0.1:5175
