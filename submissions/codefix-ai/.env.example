# ==============================================================================
# CodeFix AI â€” Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' and fill in your values:
#   Copy-Item .env.example .env (in PowerShell)
# ==============================================================================

# Flask Configuration
SECRET_KEY=change-this-in-production-to-a-secure-random-key
FLASK_ENV=development
FLASK_DEBUG=1
PORT=5000

# Ollama Local Model Configuration
# Note: Ensure Ollama is running (`ollama serve`). Default port is 11434.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:1.5b
OLLAMA_TIMEOUT=120

# IBM Db2 Database Configuration
# Fill with your IBM Cloud or on-premise Db2 instance details:
DB2_DATABASE=BLUDB
DB2_HOSTNAME=
DB2_PORT=32733
DB2_UID=
DB2_PWD=
DB2_PROTOCOL=TCPIP
DB2_SECURITY=SSL

# Application Guardrails & Security
MAX_INPUT_CHARS=10000
MAX_HISTORY_PER_SESSION=50


