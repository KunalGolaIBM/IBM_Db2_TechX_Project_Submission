# Copy to .env and replace the placeholder passwords. Placeholders only: never commit .env.
# --- IBM Db2 (docker compose reads these too) ---
DB2_HOST=127.0.0.1   # not "localhost": on Windows it tries IPv6 first and each connect stalls ~20 s
DB2_PORT=50000
DB2_DATABASE=CUSTDB
DB2_USER=db2inst1
DB2_PASSWORD=change_me_db2inst1
# End-user identities created as OS users inside the Db2 container (see Dockerfile)
PRIYA_PASSWORD=change_me_priya
ARJUN_PASSWORD=change_me_arjun

# --- LLM: auto = Groq, then Ollama, then offline scripted plans. Or: groq | ollama | none ---
CUSTODIAN_LLM=auto
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# --- Embeddings (local, 384 dims) ---
EMBED_MODEL=ibm-granite/granite-embedding-30m-english
