# ---------- IBM Db2 (placeholders only - put real values in .env, never commit .env) ----------
DB2_HOST=localhost
DB2_PORT=50000
DB2_DATABASE=testdb
DB2_USER=db2inst1
DB2_PASSWORD=your_db2_password_here
DB2_SECURITY=false
DB2_SCHEMA=ISSUESMITH

# ---------- Embeddings ----------
# sentence-transformers (semantic, needs requirements-semantic.txt) or hash (no extra install)
EMBEDDING_BACKEND=sentence-transformers
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ---------- LLM provider: none | ollama | watsonx | openai ----------
# "none" still works end to end with the rule-based writer.
LLM_PROVIDER=none

# Ollama (local, free). Example: ollama pull granite3.3:2b
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=granite3.3:2b

# IBM watsonx.ai
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_APIKEY=your_watsonx_api_key_here
WATSONX_PROJECT_ID=your_watsonx_project_id_here
WATSONX_MODEL=ibm/granite-3-3-8b-instruct

# Any OpenAI-compatible endpoint (OpenAI, OpenRouter, Groq, Gemini OpenAI endpoint)
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=your_openai_compatible_key_here
OPENAI_MODEL=gpt-4o-mini

# ---------- GitHub (optional) ----------
# Search existing issues here before drafting (works without a token, rate-limited):
GITHUB_SEARCH_REPO=IBM/db2developerextension-about
# Post approved drafts here. Use YOUR OWN test repo for demos, not the IBM repo.
GITHUB_TOKEN=your_github_token_here
GITHUB_TARGET_REPO=your-username/your-test-repo

# ---------- Agent behaviour ----------
MAX_CRITIC_ROUNDS=2
DUPLICATE_DISTANCE=0.12
