  "ibm_db2": {
    "edition": "Db2 Community Edition 12.1 (Docker / Podman)",
    "connector": "ibm_db / ibm_db_dbi, LangChain langchain-db2 (DB2VS)",
    "features_used": [
      "Relational Tables with constraints and foreign keys",
      "VECTOR(384, FLOAT32) columns and VECTOR_DISTANCE (COSINE)",
      "LangChain DB2VS vector store (BSON metadata)",
      "SQL PL stored procedure with result set",
      "Indexing",
      "Analytics views",
      "JSON_VALUE over CLOB JSON",
      "SELECT FROM FINAL TABLE (INSERT)",
      "Agent audit trail"
    ]
  },
  "tech_stack": {
    "languages": ["Python", "SQL"],
    "frameworks": ["LangGraph", "LangChain", "Streamlit"],
    "ai_models": ["IBM Granite (Ollama / watsonx.ai)", "sentence-transformers all-MiniLM-L6-v2", "Any OpenAI-compatible model (optional)"]
  }
