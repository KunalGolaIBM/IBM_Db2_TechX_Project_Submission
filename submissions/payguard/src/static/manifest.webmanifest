{
  "name": "PayGuard - check before you pay",
  "short_name": "PayGuard",
  "description": "Share a screenshot of a seller's chat and find out in seconds if it's a scam.",
  "start_url": "/#check",
  "scope": "/",
  "display": "standalone",
  "background_color": "#f5f2ea",
  "theme_color": "#0f1c2e",
  "icons": [
    {"src": "/static/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any maskable"},
    {"src": "/static/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any maskable"}
  ],
  "share_target": {
    "action": "/share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [{"name": "media", "accept": ["image/png", "image/jpeg", "image/webp", "image/*"]}]
    }
  }
}
