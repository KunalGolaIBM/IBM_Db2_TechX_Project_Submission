# Frontend build-time settings. Everything here is PUBLIC: Vite inlines VITE_* values into the browser
# bundle, so never put tokens, passwords or database settings in a VITE_* variable.

# Base URL of the CivicLens API. Leave empty to call the same origin (/api/...), which is what the
# Vite dev server and `vite preview` do by proxying to the backend.
VITE_API_BASE_URL=

# Not a VITE_ variable (never reaches the browser): where `npm run dev` / `npm run preview` proxy /api.
# API_PROXY_TARGET=http://127.0.0.1:8000
