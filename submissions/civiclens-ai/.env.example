# CivicLens AI configuration. Copy to `.env` (gitignored) and fill in real values locally.
# Placeholders only: never commit real passwords or API keys.

# --- IBM Db2 -------------------------------------------------------------------
# Local Db2 Community Edition (docker-compose.db2.yml) defaults:
DB2_HOST=localhost
DB2_PORT=50000
DB2_DATABASE=CIVICDB
DB2_USER=db2inst1
DB2_PASSWORD=change_me_local_db2_password
DB2_SCHEMA=CIVICLENS
# "false" for local Docker over TCP. Use "SSL" for Db2 on Cloud (usually port 50001).
DB2_SECURITY=false
# Optional path to a CA certificate when DB2_SECURITY=SSL
DB2_SSL_SERVER_CERTIFICATE=
DB2_CONNECT_TIMEOUT=10

# --- Application ------------------------------------------------------------------
# "production" stops serving /docs, /redoc and /openapi.json (they describe the whole attack surface).
APP_ENV=development
APP_PORT=8000
# Comma-separated list of allowed browser origins, scheme://host[:port] only (no wildcards, no paths).
# Only needed when the dashboard calls the API cross-origin (VITE_API_BASE_URL set). The dev server and
# `vite preview` proxy /api, so same-origin development needs no CORS at all.
CORS_ORIGINS=http://localhost:5173

# --- Authentication (required for /api/investigations*, /api/recommendations*) -------
# Comma-separated "id:role:token". Roles: analyst | reviewer. Tokens must be >= 24 chars.
# Generate each with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
# Unset => those endpoints return 503 (fail closed).
CIVICLENS_AUTH_TOKENS=alice:analyst:your_analyst_token_here_min24chars,rita:reviewer:your_reviewer_token_here_min24chars

# --- AI / LLM -------------------------------------------------------------------------
# "none" => only the clearly labelled rule-based fallback is available.
# Providers: openai | anthropic | watsonx   (pip install -r src/backend/requirements-llm.txt)
LLM_PROVIDER=none
LLM_MODEL=
LLM_TIMEOUT_S=30
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
WATSONX_APIKEY=your_watsonx_api_key_here
WATSONX_PROJECT_ID=your_watsonx_project_id_here
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# --- Agent limits -----------------------------------------------------------------------
AGENT_MAX_STEPS=6
AGENT_TIMEOUT_S=90

# --- Test switches --------------------------------------------------------------------
# Set to 1 to run tests/integration against the live Db2 configured above.
CIVICLENS_DB2_TESTS=0
# Set to 1 (with LLM_PROVIDER etc.) to run the billable real-LLM test.
CIVICLENS_LLM_TESTS=0
