# ==============================================================================
# BAKEBOX CHOCO AI — Environment Configuration Template
# IBM Db2 TechX Summit Hackathon Submission
# ==============================================================================

# IBM Db2 Connection Parameters (Local Community Edition or IBMDB201)
DB2_HOST=127.0.0.1
DB2_PORT=50000
DB2_DATABASE=IBMDB201
DB2_USER=your_least_privilege_db2_user
DB2_PASSWORD=your_db2_password_here
DB2_FORCE_MOCK=false

# Embedding Model Configuration (Local FastEmbed / SentenceTransformers)
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384

# API Security Configuration (Comma-separated allowed CORS origins)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:8000

# Optional: Google Gemini LLM API Key & Model Configuration
# Leave blank or omit to run in deterministic offline ground-truth mode (--no-llm)
GEMINI_MODEL=gemini-1.5-flash
GEMINI_API_KEY=your_gemini_api_key_here

# Optional Security Hardening: Operator Key (protects /api/audit/verify & masked-summary) & Audit HMAC Secret
OPERATOR_API_KEY=your_operator_api_key_here
AUDIT_HMAC_SECRET=your_audit_hmac_secret_here
