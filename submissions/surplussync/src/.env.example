# Optional local settings. Copy to .env only if password-reset email is needed.
# Signup and login do not require an email service. .env is gitignored.
# Optional SMTP settings used only to send password-reset links.
SURPLUSSYNC_SMTP_HOST=smtp.gmail.com
SURPLUSSYNC_SMTP_PORT=587
SURPLUSSYNC_SMTP_FROM=
SURPLUSSYNC_SMTP_USERNAME=
SURPLUSSYNC_SMTP_PASSWORD=
SURPLUSSYNC_FRONTEND_URL=http://localhost:5173

# Private local registration-certificate storage (not served by Vite/FastAPI).
# Default: backend/private_uploads; maximum must be 1 KB to 20 MB (default 5 MB).
SURPLUSSYNC_UPLOAD_DIR=
SURPLUSSYNC_MAX_CERTIFICATE_BYTES=5242880

# Optional presentation seed. Disabled by default; never set a password here
# in a committed file. A private environment variable is required only when
# the reserved account must be created on a fresh/ephemeral deployment.
# Set true only for a local or isolated presentation database. It enables a
# short organization setup form only for trusted profiles marked demo=1.
SURPLUSSYNC_PRESENTATION_DEMO_ENABLED=false
SURPLUSSYNC_PRESENTATION_DEMO_EMAIL=tournamentgaming07@gmail.com
SURPLUSSYNC_PRESENTATION_DEMO_PASSWORD=

# Legacy optional Turso adapter settings; these are not used for local SQLite
# and do not provide PostgreSQL support for a future Railway deployment.
# Never add real database credentials to this file or commit them.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
SURPLUSSYNC_COOKIE_SECURE=true
# For deployment, set this to the exact public HTTPS origin.
SURPLUSSYNC_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional IBM Db2 + LangChain analysis. SQLite remains the operational store.
# Configure either DB2_CONNECTION_STRING or all DB2_DATABASE/HOSTNAME/PORT/UID/PWD.
# Keep actual credentials only in the ignored local .env or secret environment.
DB2_CONNECTION_STRING=
DB2_DATABASE=
DB2_HOSTNAME=
DB2_PORT=50000
DB2_UID=
DB2_PWD=
DB2_SECURITY=SSL

# Optional IBM watsonx generation. If either key is absent, results say rules_only.
# WATSONX_API_KEY is the current IBM spelling; the older WATSONX_APIKEY is also accepted.
WATSONX_API_KEY=
WATSONX_APIKEY=
WATSONX_PROJECT_ID=
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_MODEL_ID=ibm/granite-3-3-8b-instruct
