# Optional IBM Db2 + LangChain analysis. SQLite remains the operational store.
# Configure DB2_CONNECTION_STRING OR all five individual connection fields.
# The integration requires SSL. Keep real credentials in a private .env or
# managed secret store; leave these values blank in this committed example.
DB2_CONNECTION_STRING=
DB2_DATABASE=
DB2_HOSTNAME=
DB2_PORT=50000
DB2_UID=
DB2_PWD=
DB2_SECURITY=SSL

# Optional watsonx.ai generation. Both an API key and project ID are required.
# If absent, successful Db2 retrieval uses the LangChain rules-only summary.
WATSONX_API_KEY=
# Legacy spelling accepted by the source for compatibility:
WATSONX_APIKEY=
WATSONX_PROJECT_ID=
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_MODEL_ID=ibm/granite-3-3-8b-instruct
