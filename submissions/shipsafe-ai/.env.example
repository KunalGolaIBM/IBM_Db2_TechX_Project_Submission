# ShipSafe configuration. Copy to .env (or run `shipsafe setup`, which writes ~/.shipsafe/.env).
# Never commit the real file.

# ---------------------------------------------------------------- IBM Db2
# Defaults match the local instance created by the IBM Db2 Developer Extension for VS Code.
# Use 127.0.0.1 rather than localhost: Docker/WSL port forwards for Db2 listen on IPv4 only.
DB2_HOST=127.0.0.1
DB2_PORT=50001
DB2_NAME=TESTDB
DB2_USERNAME=db2inst1
DB2_PASSWORD=your_db2_password_here
# true for Db2 on Cloud / TLS listeners
DB2_SSL=false
# Schema that holds every ShipSafe table, view, procedure and vector table (created automatically)
DB2_SCHEMA=SHIPSAFE
# Optional: admin credentials used only by `shipsafe init-db`, so the runtime user can be
# least-privilege (see docs/db2-least-privilege.sql)
# DB2_ADMIN_USERNAME=db2inst1
# DB2_ADMIN_PASSWORD=your_admin_password_here

# ----------------------------------------------------- IBM Granite (Ollama)
OLLAMA_HOST=http://localhost:11434
SHIPSAFE_CHAT_MODEL=granite4:micro
SHIPSAFE_EMBED_MODEL=granite-embedding:30m
# ollama (Granite embeddings, default) | hashing (no model server, e.g. a bare CI runner)
SHIPSAFE_EMBEDDINGS=ollama
SHIPSAFE_VECTOR_DIMENSION=384

# ------------------------------------------------------------ IDE server
# Folder the MCP server treats as the workspace (the IDE sets this; defaults to the current folder)
# SHIPSAFE_WORKSPACE=/path/to/project

# --------------------------------------------- REST API + team dashboard
SHIPSAFE_API_HOST=127.0.0.1
SHIPSAFE_API_PORT=8080
SHIPSAFE_AUTH=true
# Folders the API may scan, separated by ':' (Linux/macOS) or ';' (Windows)
SHIPSAFE_ALLOWED_ROOTS=./workspaces
SHIPSAFE_DB_POOL_SIZE=4
SHIPSAFE_MAX_CONCURRENT_SCANS=2
SHIPSAFE_SCAN_RATE_PER_MINUTE=10

# --------------------------------------------------------------- scanners
SHIPSAFE_BANDIT=true
# pip-audit (PyPI/OSV, needs network): deep (deep profile only) | always | off
SHIPSAFE_PIP_AUDIT=deep

# ---------------------------------------------------------------- logging
SHIPSAFE_LOG_FORMAT=text
SHIPSAFE_LOG_LEVEL=INFO
