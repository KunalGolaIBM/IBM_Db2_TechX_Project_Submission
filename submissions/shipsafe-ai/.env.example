# ShipSafe AI configuration. Copy to .env and fill in. Never commit .env.

# IBM Db2 (Community Edition in Docker, see docker-compose.yml)
DB2_HOST=localhost
DB2_PORT=50000
DB2_DATABASE=SAMPLE
DB2_USERNAME=db2inst1
DB2_PASSWORD=your_db2_password_here
# NONE or SSL (use SSL for Db2 on Cloud)
DB2_SECURITY=NONE
# Schema that holds the ShipSafe tables (created automatically)
DB2_SCHEMA=SHIPSAFE

# Storage backend: db2 (default) or sqlite (offline unit tests only)
SHIPSAFE_DB_BACKEND=db2

# Embeddings for the Db2 policy vector store:
#   hashing     - offline deterministic feature hashing (default, no downloads)
#   huggingface - sentence-transformers/all-MiniLM-L6-v2 (pip install .[huggingface])
SHIPSAFE_EMBEDDINGS=hashing
SHIPSAFE_VECTOR_DIMENSION=384

# MCP server (stdio) for IBM Bob or any MCP client
SHIPSAFE_ENABLE_MCP=true
