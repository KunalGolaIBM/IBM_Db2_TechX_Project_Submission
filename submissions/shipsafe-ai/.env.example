# ShipSafe AI configuration. Copy to .env and fill in. Never commit .env.

# ---------------------------------------------------------------- IBM Db2
DB2_HOST=localhost
DB2_PORT=50000
DB2_DATABASE=SAMPLE
DB2_USERNAME=db2inst1
DB2_PASSWORD=your_db2_password_here
# NONE or SSL (use SSL for Db2 on Cloud)
DB2_SECURITY=NONE
# Schema that holds the ShipSafe tables (created automatically)
DB2_SCHEMA=SHIPSAFE
# Optional: admin credentials used only by `shipsafe init-db`, so the runtime user above
# can be least-privilege (see docs/db2-least-privilege.sql)
# DB2_ADMIN_USERNAME=db2inst1
# DB2_ADMIN_PASSWORD=your_admin_password_here
SHIPSAFE_DB_POOL_SIZE=4

# --------------------------------------------------------- web UI and API
SHIPSAFE_API_HOST=127.0.0.1
SHIPSAFE_API_PORT=8080
# Bearer-token auth with viewer/operator/admin roles. Only disable for local development:
# it is refused unless the API binds to localhost.
SHIPSAFE_AUTH=true
# Folders the API may scan, separated by ':' (Linux/macOS) or ';' (Windows)
SHIPSAFE_ALLOWED_ROOTS=./workspaces
SHIPSAFE_MAX_CONCURRENT_SCANS=2
SHIPSAFE_SCAN_RATE_PER_MINUTE=10
# Only needed when the UI runs from the Vite dev server
# SHIPSAFE_CORS_ORIGINS=http://localhost:5173

# --------------------------------------------------------------- scanners
# Bandit runs automatically when installed (pip install ".[scanners]")
SHIPSAFE_BANDIT=true
# pip-audit (PyPI/OSV, needs network): deep (deep profile only) | always | off
SHIPSAFE_PIP_AUDIT=deep

# ------------------------------------------------------- policy retrieval
# hashing: offline deterministic embeddings (default, no downloads)
# huggingface: sentence-transformers/all-MiniLM-L6-v2 (pip install ".[huggingface]")
SHIPSAFE_EMBEDDINGS=hashing
SHIPSAFE_VECTOR_DIMENSION=384

# ---------------------------------------------------------------- logging
# text | json (structured, secrets redacted)
SHIPSAFE_LOG_FORMAT=text
SHIPSAFE_LOG_LEVEL=INFO

# Storage backend: db2 (default) | sqlite (offline unit tests only)
SHIPSAFE_DB_BACKEND=db2
SHIPSAFE_ENABLE_MCP=true
