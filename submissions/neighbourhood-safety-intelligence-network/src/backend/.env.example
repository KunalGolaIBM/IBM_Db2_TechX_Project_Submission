# Application Environment
APP_ENV=development
API_V1_PREFIX=/api/v1
PROJECT_NAME="Neighbourhood Safety Intelligence Network"

# Database Configuration
# Options: sqlite | postgresql | db2
DATABASE_MODE=sqlite
DATABASE_URL=sqlite:///./neighbourhood_safety.db

# PostgreSQL Configuration (used when DATABASE_MODE=postgresql)
POSTGRES_SERVER=localhost
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=neighbourhood_safety
POSTGRES_PORT=5432

# IBM Db2 Configuration (used when DATABASE_MODE=db2)
# Local Db2 Community Edition (see docker-compose.db2.yml): host localhost, port 50000, database NSIN, DB2_SECURITY empty.
# Db2 on IBM Cloud: use the host/port from your service credentials and DB2_SECURITY=SSL.
DB2_HOST=localhost
DB2_PORT=50000
DB2_DATABASE=NSIN
DB2_USER=db2inst1
DB2_PASSWORD=your_db2_password_here
DB2_SECURITY=

# Security & Authentication
JWT_SECRET=replace_with_a_long_random_string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS (comma-separated list of allowed web origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
