# Application
APP_ENV=development
PROJECT_NAME="Neighbourhood Safety Intelligence Network"

# IBM Db2 (the only database). The DB2_NAME / DB2_USERNAME / DB2_SSL spellings are also accepted.
DB2_HOST=localhost
DB2_PORT=50000
DB2_DATABASE=TESTDB
DB2_USER=db2inst1
DB2_PASSWORD=your_db2_password_here
# Empty for a local Db2; SSL for Db2 on IBM Cloud
DB2_SECURITY=
# Only when connecting as the least-privilege login (scripts/db2_least_privilege.sh): schema owning the tables
DB2_SCHEMA=

# IBM Granite models served locally by Ollama (nothing leaves the machine)
OLLAMA_HOST=http://localhost:11434
OLLAMA_CHAT_MODEL=granite3.3:2b
OLLAMA_EMBED_MODEL=granite-embedding:278m
EMBEDDING_DIM=768
ENABLE_VECTOR_SEARCH=true
ENABLE_LLM_BRIEFING=true
LLM_TIMEOUT_SECONDS=120

# Security & authentication
JWT_SECRET=replace_with_a_long_random_string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Privacy: library telemetry stays off
HAYSTACK_TELEMETRY_ENABLED=False
CREWAI_DISABLE_TELEMETRY=true
