# DriftTrace configuration TEMPLATE - placeholders only. Never commit real values.
# setup.sh creates the real file at <repo root>/.env.drifttrace (outside this folder),
# or point DB_ENV_FILE at your private copy.

# Application connection: least-privilege user (SELECT on operational tables,
# SELECT+INSERT on case tables; no UPDATE/DELETE/DDL)
DB2_DATABASE=testdb
DB2_HOSTNAME=127.0.0.1
DB2_PORT=50000
DB2_UID=driftapp
DB2_PWD=your_app_user_password_here
DB2_SCHEMA=DB2INST1
# Set to SSL for TLS endpoints (e.g. IBM Cloud Db2); leave empty for local Community Edition
DB2_SECURITY=

# Administrator: used ONLY by seed.py (schema, grants, fixture) and tests
DB2_ADMIN_UID=db2inst1
DB2_ADMIN_PWD=your_db2_admin_password_here

# Gemini Developer API key (Google AI Studio) used by LangChain ChatGoogleGenerativeAI
GOOGLE_API_KEY=your_gemini_api_key_here
AI_MODEL=gemini-3.5-flash-lite
