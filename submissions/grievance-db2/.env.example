# ==============================================================================
# Environment Configuration Template for CPGRAMS Grievance Portal (IBM Db2Hack 2026)
# Copy this file to .env before starting: `cp .env.example .env`
# ==============================================================================

# Application Environment (development, testing, production)
APP_ENV=production
DEBUG=false
API_PREFIX=/api
CORS_ORIGINS=*

# Frontend Port Configuration
FRONTEND_PORT=80
BACKEND_PORT=8000

# IBM Db2 Community Edition Database Configuration
DB2_HOST=db2
DB2_PORT=50000
DB2_DATABASE=GRIEVDB
DB2_USER=db2inst1
DB2_PASSWORD=ChangeThisPassword123!
DB2_SCHEMA=DB2INST1

# SQLAlchemy Connection URI (constructed automatically if omitted)
# Format: db2+ibm_db://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=db2+ibm_db://db2inst1:ChangeThisPassword123!@db2:50000/GRIEVDB

# ==============================================================================
# LangChain & AI Provider Configuration (Optional - Defaults to deterministic AI fallback)
# ==============================================================================
# Google Gemini (Recommended for LangChain)
GEMINI_API_KEY=
# OpenRouter / OpenAI
OPENROUTER_API_KEY=
# Local Ollama (e.g., http://localhost:11434)
OLLAMA_BASE_URL=
# IBM watsonx.ai
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
WATSONX_URL=https://us-south.ml.cloud.ibm.com
# AI Model override (e.g., gemini-2.5-flash, openai/gpt-4o-mini, llama3.2, ibm/granite-13b-chat-v2)
AI_MODEL=
