# =============================================================================
# CloudChange - IBM Db2 Integration Environment Configuration
# =============================================================================
# DO NOT COMMIT REAL SECRETS OR PASSWORDS TO SOURCE CONTROL.
# Copy this file to .env locally and populate with your environment credentials.

# -----------------------------------------------------------------------------
# Database Persistence Backend Selection
# -----------------------------------------------------------------------------
# Options: 'db2' (IBM Db2 enterprise relational storage) or 'memory' (in-memory)
DATABASE_BACKEND=db2

# -----------------------------------------------------------------------------
# IBM Db2 Connectivity Parameters
# -----------------------------------------------------------------------------
# Db2 hostname or IP address (e.g., localhost, 127.0.0.1, or db2-host.domain.com)
DB2_HOST=localhost

# Db2 service port (default: 50000 for non-SSL, 50001 for SSL)
DB2_PORT=50000

# Db2 database name (e.g., BLUDB or testdb)
DB2_DATABASE=BLUDB

# Db2 administrative or application user
DB2_USER=db2inst1

# Db2 user password
DB2_PASSWORD=your_db2_password_here

# Security mechanism: leave blank for non-SSL; set to 'SSL' for encrypted connections
DB2_SECURITY=

# Schema name to isolate CloudChange tables
DB2_SCHEMA=CLOUDCHANGE

# Path to SSL certificate (optional, only if DB2_SECURITY=SSL and using custom CA)
# DB2_SSL_SERVER_CERT=/path/to/cert.arm

# Connection timeout in seconds
DB2_TIMEOUT=30

# -----------------------------------------------------------------------------
# AWS Verification Credentials (Optional for live AWS API observations)
# -----------------------------------------------------------------------------
AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your_aws_access_key
# AWS_SECRET_ACCESS_KEY=your_aws_secret_key

# -----------------------------------------------------------------------------
# Application Server Configuration
# -----------------------------------------------------------------------------
CLOUDCHANGE_DEBUG=false
API_PORT=8000

