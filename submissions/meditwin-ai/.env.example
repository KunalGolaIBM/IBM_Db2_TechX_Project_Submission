# MediTwin AI Environment Configuration
# Copy this file to .env and fill in your values

# IBM Db2 Connection
DB2_HOST=localhost
DB2_PORT=50000
DB2_DATABASE=MEDITWIN
DB2_USER=db2inst1
DB2_PASSWORD=your_db2_password_here
DB2_SCHEMA=MEDITWIN

# Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Application
APP_NAME=MediTwin AI
APP_ENV=development
APP_DEBUG=false
MAX_UPLOAD_SIZE_MB=10

