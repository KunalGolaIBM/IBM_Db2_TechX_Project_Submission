# Environment Configuration — DB2 MedAudit

# ── IBM Db2 Connection ────────────────────────────────────────────────────────
DB2_HOST=localhost
DB2_PORT=50000
DB2_USER=db2inst1
DB2_PASS=your_db2_password_here
DB2_DB=MEDAUDIT

# ── Google Gemini API ────────────────────────────────────────────────────────
# Get a free API key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ── Application Server ───────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
