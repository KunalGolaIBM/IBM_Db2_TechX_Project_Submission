# ---- IBM Db2 (placeholders only; copy to .env and fill in; never commit .env) ----
DB2_HOST=localhost
DB2_PORT=50000
DB2_DATABASE=TMDB
DB2_USER=db2inst1
DB2_PASSWORD=change-me-before-use
DB2_SCHEMA=TIMEMACHINE
# ibm_db = native driver via ibm_db_dbi (default) | sqlalchemy = ibm_db_sa dialect (db2+ibm_db://)
DB2_DRIVER=ibm_db

# ---- LLM (optional: without a key the agents use deterministic heuristics) ----
# auto | anthropic | openai | offline
LLM_PROVIDER=auto
LLM_MODEL=
ANTHROPIC_API_KEY=
# Any OpenAI-compatible endpoint works, including a local Ollama: http://localhost:11434/v1
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# ---- Investigation limits ----
TM_MAX_ROWS=500
TM_MAX_ITERATIONS=4
TM_CONFIRM_SHARE=0.60
