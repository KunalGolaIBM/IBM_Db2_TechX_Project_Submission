# =============================================================================
# Cloud Loop — Environment Configuration
# IBM Db2 TechX Summit 2026 Submission
# =============================================================================

# 1. IBM Db2 Enterprise Connection (Primary Database)
DB2_HOSTNAME=dashdb-txn-sng01.services.dal.bluemix.net
DB2_PORT=50000
DB2_DATABASE=BLUDB
DB2_UID=db2user
DB2_PWD=your-db2-password
DB2_SSL=true
DB2_SSL_DSN=DATABASE=BLUDB;HOSTNAME=dashdb-txn-sng01.services.dal.bluemix.net;PORT=50001;PROTOCOL=TCPIP;UID=db2user;PWD=your-db2-password;Security=SSL;

# 2. Local Fallback Database (Optional for Sandbox/Offline Runs)
LOCAL_DB_PATH=cloud_loop_local.db

# 3. FastAPI Python Backend Service
FASTAPI_BACKEND_URL=http://127.0.0.1:8000
ADMIN_API_KEY=cloudloop-admin-secret-key-2026

# 4. Clerk Authentication (User Dashboard & Sign-in)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# 5. Embedding & AI Models (Optional: sentence-transformers runs offline)
GOOGLE_AI_API_KEY=AIzaSy...
OPENAI_API_KEY=sk-...
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384

# 6. Public Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

