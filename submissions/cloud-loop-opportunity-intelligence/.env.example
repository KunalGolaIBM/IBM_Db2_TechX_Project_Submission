# =============================================================================
# Cloud Loop — Environment Variables Template
# IBM Db2 TechX Summit 2026 Submission
# =============================================================================

# Application Ports & URLs
PORT=3000
ENVIRONMENT=development
DEBUG=True
AI_SERVICE_URL=http://localhost:8000
FASTAPI_BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Authentication Mode ('demo' for instant evaluation without accounts, or 'clerk')
AUTH_MODE=demo
NEXT_PUBLIC_AUTH_MODE=demo
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_dummy_key_placeholder
CLERK_SECRET_KEY=sk_test_dummy_key_placeholder

# Security Keys
INTERNAL_API_KEY=your_internal_api_key_here
ADMIN_API_KEY=your_admin_api_key_here

# Contact Information
NEXT_PUBLIC_CONTACT_EMAIL=student@cloudloop.dev
NEXT_PUBLIC_CONTACT_PHONE=+91-9876543210

# IBM Db2 Enterprise / Community Connection
DB2_HOST=localhost
DB2_PORT=50000
DB2_DB=BLUDB
DB2_USERNAME=db2inst1
DB2_PASSWORD=your_db2_password_here
DB2_SCHEMA=CLOUDLOOP
DB2_SSL=False

# Haystack AI Settings
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384
DISTANCE_METRIC=COSINE

# Optional Local LLM via Ollama
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.2:latest
