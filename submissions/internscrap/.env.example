# Database Backend: 'db2' (native IBM Db2) or 'simulated' (offline fallback mode)
DB_BACKEND=db2

# IBM Db2 Configuration (Placeholders only - do not commit real passwords)
DB2_HOST=localhost
DB2_PORT=50000
DB2_DATABASE=testdb
DB2_USER=db2inst1
DB2_PASSWORD=your_db2_password_here
DB2_SECURITY=None

# Scraper Settings
SCRAPER_TIMEOUT=15
SCRAPER_USER_AGENT=InternScrap-Agent/1.0
