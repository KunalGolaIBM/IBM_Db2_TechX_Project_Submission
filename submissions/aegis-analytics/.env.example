# ── IBM Db2 AI & Analytics Toolkit Configuration ─────────────────────────────
DB2_DATABASE=BLUDB
DB2_HOSTNAME=localhost
DB2_PORT=50000
DB2_PROTOCOL=TCPIP
DB2_UID=db2inst1
DB2_PWD=your_secure_password_here
DB2_SECURITY=NONE
DB2_SSL_SERVER_CERT=
DB2_MOCK_FALLBACK=true

# ── AI & LLM Provider Keys (Placeholders only) ────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_API_KEY=your_google_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# ── Application Configuration ────────────────────────────────────────────────
APP_ENV=development
APP_PORT=8000
DATA_DB_PATH=data/app.db
MODEL_DIR=models
SYMBOLS=RELIANCE.NS,INFY.NS,TCS.NS
