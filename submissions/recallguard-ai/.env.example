# RecallGuard AI — environment template. Copy to .env (never commit .env).
# Placeholders only; no real credentials belong in this file.

# ---------------- Database ----------------
# db2 = IBM Db2 (system of record).  dev = embedded engine for local UI work,
# clearly labelled "DEV MODE — NOT IBM Db2" in the API and UI.
DB_MODE=db2
DB2_HOST=localhost
DB2_PORT=50000
DB2_DATABASE=RECALLDB
DB2_USER=db2inst1
DB2_PASSWORD=change_me_db2_password
# Set to SSL for Db2 on Cloud (port is usually 30000-range); leave blank for local Docker
DB2_SECURITY=
DB2_SCHEMA=
AUTO_MIGRATE=true
AUTO_SEED=true

# Used only by docker-compose to initialise the Db2 Community Edition container
DB2INST1_PASSWORD=change_me_db2_password

# ---------------- AI / LLM (optional) ----------------
# none -> deterministic, clearly-labelled fallback agents (no LLM is called)
# openai | anthropic | gemini | watsonx | ollama -> CrewAI agents with that provider
LLM_PROVIDER=none
LLM_MODEL=
LLM_BASE_URL=
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
WATSONX_APIKEY=your_watsonx_api_key_here
WATSONX_PROJECT_ID=your_watsonx_project_id_here
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# ---------------- Retrieval ----------------
# hashing = local deterministic embedder (no key). openai = text-embedding-3-small
EMBEDDING_PROVIDER=hashing
EMBEDDING_DIM=256
VECTOR_TABLE=RG_EVIDENCE_VECTORS

# ---------------- Application ----------------
APP_ENV=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_UPLOAD_MB=10
# true = reject requests without X-User-Id / X-User-Role headers
REQUIRE_AUTH_HEADERS=false
