# ==============================================================================
# FinSight AI — Environment Configuration Template (.env.example)
# IBM Db2Hack 2026 Submission
# ==============================================================================

# IBM Db2 12.1.5.0 Database Configuration
DB2_HOST=localhost
DB2_PORT=50000
DB2_DATABASE=FINDB
DB2_USER=db2inst1
DB2_PASSWORD=your_db2_instance_password_here

# Internal AI Service Configuration (FastAPI)
AI_SERVICE_HOST=0.0.0.0
AI_SERVICE_PORT=8000
AI_SERVICE_INTERNAL_TOKEN=your_32_byte_random_service_token_here
LLM_MODEL=gemini-3.1-flash-lite
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Google Gemini API Key
# Optional for Mode B LLM synthesis; FinSight AI operates 100% deterministically in Mode A without it.
GEMINI_API_KEY=your_gemini_api_key_placeholder

# Public Rust API Gateway Configuration (Axum)
RUST_SERVER_HOST=0.0.0.0
RUST_SERVER_PORT=8080
AI_SERVICE_URL=http://localhost:8000
CSRF_SECRET=your_32_byte_csrf_hmac_secret_here
SESSION_TTL_HOURS=24
COOKIE_SECURE=false
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
RUST_LOG=info,finsight_rust_api=debug

# Frontend Configuration (Vite)
VITE_API_BASE_URL=http://localhost:8080
