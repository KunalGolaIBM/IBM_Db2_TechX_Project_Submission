# IBM Db2 (placeholders only - never commit real values)
DB2_HOST=localhost
DB2_PORT=50000
DB2_DATABASE=QMEDX
DB2_USER=db2inst1
DB2_PASSWORD=change_me_in_your_local_env_file
DB2_POOL_SIZE=5

# LLM for CrewAI mode (keys stay in your local .env). Natively supported providers include
# openai, anthropic, gemini. Others such as groq also need: pip install litellm
LLM_PROVIDER=openai
LLM_MODEL=your_model_name_here
LLM_API_KEY=your_llm_api_key_here

# Application
APP_ENV=development
APP_PORT=8000
JWT_SECRET=generate_a_long_random_string
CORS_ORIGINS=http://localhost:5173
