# Copy to src/.env for the local Community Edition demo.
# Set DB2_PASSWORD to the password you chose during Db2 setup.
DB2_HOST=127.0.0.1
DB2_PORT=50000
DB2_DATABASE=TESTDB
DB2_USER=db2inst1
DB2_PASSWORD=
DB2_SCHEMA=
# Disable TLS for the loopback demo. Enable TLS for Db2 on Cloud.
DB2_TLS=0
DB2_SSL_CERT=

RECALLTRACE_PROVIDER=ollama
RECALLTRACE_MODEL=granite3.3:2b
# Optional for RECALLTRACE_PROVIDER=openai.
OPENAI_API_KEY=
