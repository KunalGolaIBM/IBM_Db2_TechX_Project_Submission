# IBM Db2 configuration
DB2_HOST=localhost
DB2_PORT=50000
DB2_DATABASE=SAMPLE
DB2_USER=db2inst1
DB2_PASSWORD=your_db2_password
DB2_DSN=DATABASE=SAMPLE;HOSTNAME=localhost;PORT=50000;PROTOCOL=TCPIP;UID=db2inst1;PWD=your_db2_password;

# Optional AI model provider
OPENAI_API_KEY=your_openai_api_key_here

# Application config
APP_ENV=development
APP_NAME=box-office-inc
