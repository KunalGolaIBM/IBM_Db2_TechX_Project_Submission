# ---------------------------------------------------------------------------
# IBM Db2 (placeholders only - never commit real passwords)
# ---------------------------------------------------------------------------
DB2_HOST=localhost
DB2_PORT=50000
DB2_DATABASE=HOTELDB
# Manager / application identity (Db2 instance owner in the container)
DB2_USER=db2inst1
DB2_PASSWORD=change_me_db2inst1_password
# Least-privileged identity used for every query issued by the AI agents
DB2_AGENT_USER=opsagent
DB2_AGENT_PASSWORD=change_me_agent_password
# Security administrator for label-based access control (LBAC) on guest notes. Optional: without it,
# setup skips LBAC. A separate login because Db2 does not let an ID grant security labels to itself.
DB2_SECADM_USER=hotelsec
DB2_SECADM_PASSWORD=change_me_secadm_password
DB2_SECURITY=false

# ---------------------------------------------------------------------------
# LLM provider (LangChain chat model)
# ---------------------------------------------------------------------------
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.5-flash
# Each Gemini model has its own free-tier daily quota. When one is used up, the agents switch to the next.
LLM_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-2.5-flash
LLM_TEMPERATURE=0
# Client-side requests-per-minute cap. Gemini free tier is ~10 RPM; raise it on a paid key.
LLM_RPM=8
# Get a free key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_gemini_api_key_here

# ---------------------------------------------------------------------------
# Embeddings (local, ONNX via fastembed - 384 dimensions)
# ---------------------------------------------------------------------------
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
SQL_ROW_LIMIT=200
# Db2 EXPLAIN cost ceiling (timerons) for SQL written by the agents; legitimate agent queries cost ~80-2,100
SQL_MAX_COST=25000
MANAGER_NAME=duty.manager
