# =============================================================================
# Kisan Mitra (किसान मित्र) - Environment Configuration
# =============================================================================

# -----------------------------------------------------------------------------
# IBM Db2 Database Configuration
# -----------------------------------------------------------------------------
DB2_HOST=localhost
DB2_PORT=50000
DB2_DATABASE=KISANMIT
DB2_USER=db2inst1
DB2_PASSWORD=KisanMitra2026!
DB2_READONLY_USER=kisan_ro
DB2_READONLY_PASSWORD=KisanReadOnly2026!
DB2_DRIVER={IBM DB2 ODBC DRIVER}
# DB2_MODE:
#   'auto'     - Connects to native IBM Db2 if available; seamlessly falls back to 
#                high-fidelity local Db2-dialect emulation for development/testing
#   'native'   - Enforces direct connection to live IBM Db2 12.1+ instance
#   'emulated' - Uses local high-fidelity Db2 engine with full Db2 syntax & vector cosine metrics
DB2_MODE=auto

# -----------------------------------------------------------------------------
# LLM Provider Configuration (gemini | watsonx | ollama)
# -----------------------------------------------------------------------------
LLM_PROVIDER=gemini

# Google Gemini API
GEMINI_API_KEY=your_google_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# IBM watsonx.ai (Alternative enterprise provider)
WATSONX_APIKEY=
WATSONX_PROJECT_ID=
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_MODEL_ID=ibm/granite-13b-chat-v2

# Ollama (Alternative local open-source provider)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# -----------------------------------------------------------------------------
# Embeddings Configuration
# Local 384-dimensional multilingual sentence-transformers model supporting Hindi & English
# Matches Db2 schema: VECTOR(384, REAL)
# -----------------------------------------------------------------------------
EMBEDDING_MODEL_NAME=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIMENSION=384

# -----------------------------------------------------------------------------
# Government Data Portals (data.gov.in Agmarknet API)
# -----------------------------------------------------------------------------
DATA_GOV_API_KEY=your_data_gov_in_api_key_here
DATA_GOV_RESOURCE_ID=9ef84268-d588-465a-a308-a864a43d0070
