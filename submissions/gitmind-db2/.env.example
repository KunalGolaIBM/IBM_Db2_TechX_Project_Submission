# GitMind 2.0 Configuration
# Copy this file to .env and fill in your values

# Storage Backend: "db2" (primary production backend)
STORAGE_BACKEND=db2

# IBM Db2 Cloud / Community Edition Connection Details
DB2_DATABASE=BLUDB
DB2_HOST=your-db2-host.databases.appdomain.cloud
DB2_PORT=50001
DB2_USERNAME=your-db2-username
DB2_PASSWORD=your-db2-password
DB2_SSL=true
DB2_SSL_CERTIFICATE=

# Db2 Schema and Vector Table
DB2_SCHEMA=GITMIND
DB2_VECTOR_TABLE=GITMIND_VECTORS

# LLM Provider: "gemini" or "openai"
LLM_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key
OPENAI_API_KEY=your-openai-api-key

# Model names
GEMINI_MODEL=gemini-2.5-flash
OPENAI_MODEL=gpt-4o-mini

# Embedding Provider: "gemini" or "openai"
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=models/gemini-embedding-001
EMBEDDING_DIMENSION=768

# GitHub Personal Access Token (optional - enables GitHub Agent & PR/Issue tracing)
# Create at: https://github.com/settings/tokens
GITHUB_TOKEN=your-github-token

# Observability & Tracing (optional)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=your-langsmith-api-key
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_PROJECT=gitmind-2.0
