# IBM Db2 connection (placeholders only - copy to .env and fill in; never commit .env)
DB2_HOST=localhost
DB2_PORT=50000
DB2_DATABASE=testdb
DB2_USER=db2inst1
DB2_PASSWORD=your_db2_password_here
DB2_SECURITY=false

# Table names (plain Db2 identifiers)
DOCTOR_KB_TABLE=DOCTOR_KB
DOCTOR_VECTOR_TABLE=DOCTOR_KB_VECTORS
DOCTOR_LOG_TABLE=DOCTOR_QUERY_LOG

# Embeddings run locally; no API key needed
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Optional LLM explanation: "none" (default) or "ollama"
LLM_PROVIDER=none
OLLAMA_MODEL=llama3.2
OLLAMA_BASE_URL=http://localhost:11434
