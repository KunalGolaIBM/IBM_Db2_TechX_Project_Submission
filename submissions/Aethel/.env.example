# Copy this file to .env and replace every placeholder locally.
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO
ALLOWED_HOSTS=localhost,127.0.0.1,testserver

# For the IBM Db2-backed submission/demo, set REQUIRE_DB2=true.
# Use false only for temporary UI development; memory data disappears on restart.
REQUIRE_DB2=true
DB2_HOST=your-db2-hostname
DB2_PORT=5000
DB2_DATABASE=your-database-name
DB2_USER=your-db2-username
DB2_PASSWORD=replace-with-your-db2-password

# Generate a long random value; keep this private.
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-characters
COOKIE_SECURE=false

# Optional: required only for the hosted conversational AI feature.
OPENAI_API_KEY=replace-with-your-api-key
OPENAI_MODEL=gpt-4o-mini
