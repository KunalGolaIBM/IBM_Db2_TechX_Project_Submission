# Db2 LockLens configuration - placeholders only. Copy to .env and edit. Never commit .env.

# --- IBM Db2 connection (required) ---
DB2_HOST=localhost
DB2_PORT=50000
DB2_DATABASE=testdb
DB2_USER=db2inst1
DB2_PASSWORD=your_db2_password_here
# true enables SSL (SECURITY=SSL); the server must be configured for it
DB2_SECURITY=false

# --- Polling and thresholds (optional, defaults shown) ---
LOCKLENS_POLL_SECONDS=5
LOCKLENS_AUTO_REFRESH=false
LOCKLENS_WAIT_WARN_SECONDS=10
LOCKLENS_WAIT_CRITICAL_SECONDS=60
LOCKLENS_MAX_ROWS=2000
LOCKLENS_CONNECT_TIMEOUT=15

# --- Incident history in Db2 (optional) ---
LOCKLENS_SCHEMA=LOCKLENS
LOCKLENS_AUTO_RECORD=true
LOCKLENS_RECORD_MIN_SEVERITY=WARNING

# --- Optional local model via Ollama (not required; no API keys involved) ---
LOCKLENS_LLM_ENABLED=false
LOCKLENS_OLLAMA_URL=http://localhost:11434
LOCKLENS_OLLAMA_MODEL=llama3.2:3b
LOCKLENS_LLM_TIMEOUT=60

LOCKLENS_LOG_LEVEL=INFO
