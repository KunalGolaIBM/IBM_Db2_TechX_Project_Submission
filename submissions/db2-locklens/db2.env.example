# Copy to .env.db2 (never commit it). Variables are those documented for IBM's Db2 container image.
# Using the image means accepting the Db2 Community Edition license terms.
LICENSE=accept
DB2INSTANCE=db2inst1
DB2INST1_PASSWORD=choose_a_password_here
DBNAME=testdb
BLU=false
ENABLE_ORACLE_COMPATIBILITY=false
UPDATEAVAIL=NO
TO_CREATE_SAMPLEDB=false
REPODB=false
IS_OSXFS=false
PERSISTENT_HOME=false
