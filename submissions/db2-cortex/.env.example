# IBM Db2 Configuration (placeholders only - do not commit real passwords)
DB2_HOST=localhost
DB2_PORT=50000
DB2_DATABASE=CORTEX
DB2_USER=db2inst1
DB2_PASSWORD=your_db2_password_here
DB2_SECURITY=false

# LLM provider: demo (offline, no key) | ollama | watsonx | openai | gemini
LLM_PROVIDER=demo
OLLAMA_MODEL=llama3.1
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_APIKEY=your_watsonx_api_key_here
WATSONX_PROJECT_ID=your_watsonx_project_id_here
OPENAI_API_KEY=your_openai_api_key_here

# Embeddings: auto (MiniLM via fastembed, falls back to hashing) | fastembed | hf | hash
EMBEDDINGS=auto

# Application Configuration
APP_ENV=development
APP_PORT=8000
