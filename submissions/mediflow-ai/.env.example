# Application mode: demo or db2
DATA_BACKEND=demo
APP_ENV=development
APP_PORT=8000

# Local IBM Db2 Community Edition container + application connection
DB2_HOST=127.0.0.1
DB2_PORT=50000
DB2_DATABASE=MEDIFLOW
DB2_USER=db2inst1
# Set a strong local password; this value is only a placeholder.
DB2_PASSWORD=change_this_local_password
DB2_SECURITY=false
