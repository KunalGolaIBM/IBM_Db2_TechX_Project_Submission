# Copy to .env and choose your own passwords. Nothing here is a real secret.
DB2_DATABASE=AQIDB
DB2_HOST=db2
DB2_PORT=50000
DB2_USER=db2inst1
DB2_PASSWORD=change-me-db2
DB2_READER_USER=aqreader
DB2_READER_PASSWORD=change-me-reader
# The web app's own login (SELECT + INSERT only). Leave the password empty to run the app as DB2_USER.
DB2_APP_USER=aqapp
DB2_APP_PASSWORD=change-me-app
OLLAMA_URL=http://ollama:11434
LLM_MODEL=granite4-micro
EMBED_MODEL=granite-embed
