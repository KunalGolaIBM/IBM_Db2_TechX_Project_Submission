# ==============================================================================
# Db2-Sentinel Environment Configuration
# IBM Db2 TechX Db2Hack 2026
# ==============================================================================

# IBM Db2 Community Edition (Local Docker Container)
DB2_HOST=localhost
DB2_PORT=50000
DB2_DATABASE=SENTINEL
DB2_USER=db2inst1
DB2_PASSWORD=SentinelDb2_2026!
DB2_SCHEMA=DB2INST1

# LLM Agent Configuration (OpenAI, Gemini, Ollama, etc.)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL_NAME=gpt-4o-mini
# OPENAI_API_BASE=http://localhost:11434/v1 # If using local Ollama

# Sentinel Agent Runtime Settings
SENTINEL_MAX_ITERATIONS=5
SENTINEL_VERBOSE=true
SENTINEL_SIMULATION_FALLBACK=true

