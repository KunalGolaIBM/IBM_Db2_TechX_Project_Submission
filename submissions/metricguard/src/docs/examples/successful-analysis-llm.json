  "sql": {
    "text": "WITH eligible_orders AS (\n    SELECT o.ORDER_ID, o.ORDER_TS, o.REGION_CODE, o.CHANNEL_CODE\n    FROM METRICGUARD.ORDERS o\n    WHERE o.STATUS IN (CAST(? AS VARCHAR(16)))\n      AND o.ORDER_TS >= CAST(? AS TIMESTAMP)\n      AND o.ORDER_TS < CAST(? AS TIMESTAMP)\n),\nline_facts AS (\n    SELECT e.ORDER_ID, e.ORDER_TS, e.REGION_CODE, e.CHANNEL_CODE, p.CATEGORY,\n           (i.QUANTITY * i.UNIT_PRICE) - i.DISCOUNT_AMOUNT AS LINE_REVENUE,\n           CAST(0 AS DECIMAL(10,2)) AS LINE_REFUND\n    FROM eligible_orders e\n    JOIN METRICGUARD.ORDER_ITEMS i ON i.ORDER_ID = e.ORDER_ID\n    JOIN METRICGUARD.PRODUCTS p ON p.PRODUCT_ID = i.PRODUCT_ID\n)\nSELECT COUNT(DISTINCT f.ORDER_ID) AS ORDER_COUNT,\n       CAST(ROUND(CAST(SUM(f.LINE_REVENUE) AS DECIMAL(25,4)) / NULLIF(COUNT(DISTINCT f.ORDER_ID), 0), 2) AS DECIMAL(18,2)) AS AVERAGE_ORDER_VALUE\nFROM line_facts f",
    "dialect": "db2",
    "parameters": [
      {
        "position": 1,
        "name": "eligible_status_1",
        "db2_type": "VARCHAR(16)",
        "value": "COMPLETED"
      },
