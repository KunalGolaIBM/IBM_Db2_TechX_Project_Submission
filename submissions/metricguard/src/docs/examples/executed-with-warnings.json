  "sql": {
    "text": "WITH eligible_orders AS (\n    SELECT o.ORDER_ID, o.ORDER_TS, o.REGION_CODE, o.CHANNEL_CODE\n    FROM METRICGUARD.ORDERS o\n    WHERE o.STATUS IN (CAST(? AS VARCHAR(16)))\n      AND o.ORDER_TS >= CAST(? AS TIMESTAMP)\n      AND o.ORDER_TS < CAST(? AS TIMESTAMP)\n),\nline_facts AS (\n    SELECT e.ORDER_ID, e.ORDER_TS, e.REGION_CODE, e.CHANNEL_CODE, p.CATEGORY,\n           (i.QUANTITY * i.UNIT_PRICE) - i.DISCOUNT_AMOUNT AS LINE_REVENUE,\n           CAST(0 AS DECIMAL(10,2)) AS LINE_REFUND\n    FROM eligible_orders e\n    JOIN METRICGUARD.ORDER_ITEMS i ON i.ORDER_ID = e.ORDER_ID\n    JOIN METRICGUARD.PRODUCTS p ON p.PRODUCT_ID = i.PRODUCT_ID\n)\nSELECT VARCHAR_FORMAT(f.ORDER_TS, 'YYYY-MM') AS ORDER_MONTH,\n       CAST(COALESCE(SUM(f.LINE_REVENUE), 0) AS DECIMAL(18,2)) AS GROSS_REVENUE\nFROM line_facts f\nGROUP BY VARCHAR_FORMAT(f.ORDER_TS, 'YYYY-MM')\nORDER BY ORDER_MONTH ASC\nFETCH FIRST 101 ROWS ONLY",
    "dialect": "db2",
