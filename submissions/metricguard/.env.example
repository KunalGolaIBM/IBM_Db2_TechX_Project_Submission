# Copy to .env (never commit .env). All values below are placeholders.

# --- IBM Db2 (local Community Edition defaults) ---
DB2_HOST=localhost
DB2_PORT=50000
DB2_DATABASE=MGDB
DB2_USER=db2inst1
DB2_PASSWORD=change_me_local_only
DB2_SCHEMA=METRICGUARD
# Optional least-privilege, SELECT-only account for analytical queries
# (created by `make db-reader` for the local container).
DB2_READER_USER=mgreader
DB2_READER_PASSWORD=change_me_reader_local_only
# Optional least-privilege audit account: INSERT + SELECT on QUERY_AUDIT_LOG only
# (created by `make db-audit-user`, granted by `make db-migrate`).
DB2_AUDIT_USER=mgaudit
DB2_AUDIT_PASSWORD=change_me_audit_local_only
# Image tag for docker/compose.yaml (pin for reproducibility).
DB2_IMAGE_TAG=latest

# --- IBM Cloud Db2 (alternative; uncomment and fill) ---
# DB2_HOST=<your-instance>.databases.appdomain.cloud
# DB2_PORT=<ssl-port>
# DB2_DATABASE=bludb
# DB2_USER=<service-credential-username>
# DB2_PASSWORD=<service-credential-password>
# DB2_SECURITY=true
# DB2_SSL_SERVER_CERTIFICATE=/absolute/path/to/DigiCertGlobalRootCA.crt
DB2_SECURITY=false

# --- Query execution limits ---
QUERY_TIMEOUT_SECONDS=15
MAX_RESULT_ROWS=500

# --- AI planner (Stage 3.5) ---
# AI_PROVIDER selects who plans: meta | anthropic | demo | auto.
#   meta       Meta Model API via LangChain (real inference). Needs MODEL_API_KEY. Never falls back to demo.
#   anthropic  optional legacy adapter. Needs ANTHROPIC_API_KEY.
#   demo       the labelled DEMO_RULE_BASED rule planner (no AI).
#   auto       (default when unset) meta if MODEL_API_KEY is set, else anthropic if ANTHROPIC_API_KEY is set, else demo.
# Precedence: AI_PROVIDER, else the deprecated PLANNER_MODE (auto | llm | demo), else auto.
AI_PROVIDER=meta
# Meta Model API key from the Model API dashboard (https://dev.meta.ai). NOT a Llama API or Meta AI app token.
MODEL_API_KEY=
META_MODEL=muse-spark-1.3
META_BASE_URL=https://api.meta.ai/v1
# Chat Completions reasoning_effort (https://dev.meta.ai/docs/reasoning): minimal | low | medium | high | xhigh | max.
# Empty = send nothing (the model picks its own level). `low` is the recommended demo setting: same 37/37 benchmark
# result as the default, about half the latency. See docs/AI_PROVIDER_CONFIGURATION.md.
META_REASONING_EFFORT=low
# Shared by both real providers. Per-attempt timeout; the SDK retries once, so the worst case is ~2x this (+ backoff),
# which must stay below the browser's 90 s analyze timeout.
PLANNER_TIMEOUT_SECONDS=30
PLANNER_MAX_RETRIES=1
# Optional Anthropic adapter (AI_PROVIDER=anthropic only). A Claude subscription is NOT an API key.
ANTHROPIC_API_KEY=
PLANNER_MODEL=claude-sonnet-5-5
PLANNER_EFFORT=low

# --- API server ---
APP_ENV=development
APP_PORT=8000
CORS_ORIGINS=http://localhost:3000
