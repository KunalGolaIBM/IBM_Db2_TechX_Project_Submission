# Example environment config. Copy to .env and fill in real values.
# Never commit a real .env file. The values below are for the local
# containers in docker-compose.yml only.

# PostgreSQL source
PARITY_SOURCE_HOST=localhost
PARITY_SOURCE_PORT=5432
PARITY_SOURCE_USER=parity
PARITY_SOURCE_PASSWORD=change-me
PARITY_SOURCE_DB=parity_source

# IBM Db2 target
PARITY_DB2_HOST=localhost
PARITY_DB2_PORT=50000
PARITY_DB2_USER=db2inst1
PARITY_DB2_PASSWORD=change-me
PARITY_DB2_DB=parity

# Model endpoint for the agents. Leave the key empty for replay mode.
PARITY_LLM_BASE_URL=http://localhost
PARITY_LLM_MODEL=recorded-model
PARITY_LLM_API_KEY=
