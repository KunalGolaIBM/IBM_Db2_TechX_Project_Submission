# ─────────────────────────────────────────────────────────────────────────────
# IBM Db2 Connection — copy this file to .env and fill in your credentials
# NEVER commit the real .env file to version control
# ─────────────────────────────────────────────────────────────────────────────

# IBM Db2 instance (Community Edition Docker or IBM Cloud)
DB2_HOST=localhost
DB2_PORT=50000
DB2_DATABASE=SAMPLE
DB2_USER=db2inst1
DB2_PASSWORD=your_db2_password_here
DB2_SECURITY=SSL          # Set to NONE for local Docker without SSL

# ─────────────────────────────────────────────────────────────────────────────
# IBM watsonx.ai — LangChain LLM provider
# Leave empty to use the Ollama / heuristic fallback instead
# ─────────────────────────────────────────────────────────────────────────────
WATSONX_API_KEY=your_watsonx_api_key_here
WATSONX_PROJECT_ID=your_watsonx_project_id_here
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_MODEL_ID=ibm/granite-13b-instruct-v2

# ─────────────────────────────────────────────────────────────────────────────
# Ollama local fallback (optional — runs Granite 3.3 locally)
# ─────────────────────────────────────────────────────────────────────────────
OLLAMA_MODEL=granite3.3:8b

# ─────────────────────────────────────────────────────────────────────────────
# Firebase (read-only sync source — optional for db2_sync.py)
# ─────────────────────────────────────────────────────────────────────────────
GOOGLE_APPLICATION_CREDENTIALS=/path/to/firebase-service-account.json

# ─────────────────────────────────────────────────────────────────────────────
# FastAPI server
# ─────────────────────────────────────────────────────────────────────────────
PORT=8000
