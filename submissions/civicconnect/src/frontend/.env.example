# ─────────────────────────────────────────────────────────────────────────────
# CivicConnect Frontend — copy to .env and fill in values
# NEVER commit .env or firebase-applet-config.json with real credentials
# ─────────────────────────────────────────────────────────────────────────────

# Port for the Express/Vite dev server
PORT=3000

# URL of the Python FastAPI backend (IBM Db2 + LangChain)
BACKEND_API_URL=http://localhost:8000

# Firebase project config (used by src/firebase.ts)
# Get these from Firebase Console → Project Settings → Your apps
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_APP_ID=your-firebase-app-id
FIREBASE_API_KEY=your-firebase-api-key
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
FIREBASE_DATABASE_ID=your-firestore-database-id
