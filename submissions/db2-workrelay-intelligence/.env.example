# ========================================================================
# Db2 WorkRelay Intelligence — Environment Configuration Template
# ========================================================================
# Copy this file to .env before starting the application:
#   cp .env.example .env
#
# NOTE: .env is git-ignored and contains your local runtime credentials.
# NEVER commit .env or plain-text credentials to version control.
# ========================================================================

# ------------------------------------------------------------------------
# 1. IBM Db2 Database Configuration (Live Instance)
# ------------------------------------------------------------------------
# Default configuration matches the local IBM Db2 Community Edition container
# running on localhost:50000 with instance db2inst1 and database testdb.
# IMPORTANT: DB2_PASSWORD here must match the password set via DB2INST1_PASSWORD in .env.db2.
DB2_HOST=localhost
DB2_PORT=50000
DB2_DATABASE=testdb
DB2_USER=db2inst1
DB2_PASSWORD=your_secure_db2_password_here
DB2_PROTOCOL=TCPIP

# ------------------------------------------------------------------------
# 2. Database Driver & Mock Execution Mode
# ------------------------------------------------------------------------
# Set DB2_USE_MOCK=false to connect to live IBM Db2 via native ibm_db driver.
# Set DB2_USE_MOCK=true to force the offline SQLite in-memory fallback
# (useful for lightweight CI pipelines or machines without Db2 / Docker).
DB2_USE_MOCK=false
DB2_SQLITE_PATH=:memory:

# ------------------------------------------------------------------------
# 3. Application Server Configuration
# ------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# ------------------------------------------------------------------------
# 4. Operational Runbook & Knowledge Retrieval Configuration
# ------------------------------------------------------------------------
# The built-in LangChain knowledge retrieval engine runs locally and deterministically
# without requiring external cloud LLM API keys or vector databases.
AI_PROVIDER=local_heuristic

# Optional placeholders for future roadmap enhancements (watsonx.ai Granite / external LLMs):
OPENAI_API_KEY=
GEMINI_API_KEY=
WATSONX_APIKEY=
